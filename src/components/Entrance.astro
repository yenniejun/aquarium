---
/**
 * First-visit welcome: closed velvet curtains with a card explaining the exhibit. "Enter" draws
 * the curtains back. Shown once per exhibit per browser (?reset shows it again). Pure CSS art.
 */
import type { Exhibit } from '../lib/exhibits';
import ExhibitTitle from './ExhibitTitle.astro';

interface Props {
  exhibit: Exhibit;
}

const { exhibit } = Astro.props;
const key = `museum:entered:${exhibit.slug}`;
---

<dialog class="entrance" aria-labelledby="entrance-title">
  <div class="curtain left" aria-hidden="true"></div>
  <div class="curtain right" aria-hidden="true"></div>
  <div class="valance" aria-hidden="true"></div>
  <form class="card" method="dialog">
    <svg class="fan" viewBox="0 0 120 44" aria-hidden="true">
      <g stroke="currentColor" stroke-width="1.2" fill="none">
        <path d="M10 42a50 50 0 0 1 100 0"></path>
        <path d="M24 42a36 36 0 0 1 72 0"></path>
        <path d="M60 42 60 6M60 42 33 14M60 42 87 14M60 42 18 30M60 42 102 30"></path>
      </g>
      <circle cx="60" cy="42" r="3" fill="currentColor"></circle>
    </svg>
    <p class="eyebrow">Welcome to</p>
    <h2 id="entrance-title"><ExhibitTitle title={exhibit.title} /></h2>
    {exhibit.intro && <p>{exhibit.intro}</p>}
    {exhibit.mode === 'blind' && <p>The tanks are unlabeled. Click your favorite to find out who made what.</p>}
    <button autofocus>Enter</button>
  </form>
</dialog>

{/* Inline so the curtain is up before the first paint, rather than flashing the exhibit. */}
<script is:inline define:vars={{ key }}>
  const dialog = document.currentScript.previousElementSibling;
  let seen = false;
  try {
    if (new URLSearchParams(location.search).has('reset')) localStorage.removeItem(key);
    seen = !!localStorage.getItem(key);
  } catch {}
  if (seen) {
    dialog.remove();
  } else {
    dialog.showModal();
    const open = (e) => {
      e?.preventDefault();
      if (dialog.classList.contains('opening')) return;
      dialog.classList.add('opening');
      try {
        localStorage.setItem(key, '1');
      } catch {}
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => dialog.close(), still ? 0 : 1900);
    };
    dialog.addEventListener('submit', open);
    dialog.addEventListener('cancel', open); // Esc
    dialog.addEventListener('close', () => dialog.remove());
  }
</script>

<style>
  .entrance {
    --velvet-dark: #3d050d;
    --velvet: #8e1424;
    --velvet-light: #c92a3c;
    --gold: #e2c46e;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    color: #f3ead3;
  }

  .entrance::backdrop {
    background: transparent;
  }

  /* Velvet: repeating folds, darker at the top under the valance and at the floor. */
  .curtain {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50.5%;
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent 22%, transparent 80%, rgba(0, 0, 0, 0.5)),
      repeating-linear-gradient(
        90deg,
        var(--velvet-dark) 0,
        var(--velvet) 2%,
        var(--velvet-light) 3.6%,
        var(--velvet) 5.2%,
        var(--velvet-dark) 7.5%
      );
    transition:
      transform 1.7s cubic-bezier(0.65, 0, 0.25, 1),
      opacity 0.4s 1.5s;
  }

  /* Gold fringe along the hem. */
  .curtain::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 16px;
    background:
      linear-gradient(#f3dc8a, #a57a28) top / 100% 4px no-repeat,
      repeating-linear-gradient(90deg, var(--gold) 0 2px, transparent 2px 5px);
  }

  .left {
    left: 0;
    transform-origin: 0 50%;
    box-shadow: inset -24px 0 40px -20px rgba(0, 0, 0, 0.6);
  }

  .right {
    right: 0;
    transform-origin: 100% 50%;
    box-shadow: inset 24px 0 40px -20px rgba(0, 0, 0, 0.6);
  }

  /* Drawing the curtains: each side gathers into its wing, folds bunching up. */
  .opening .curtain {
    transform: scaleX(0.07);
    opacity: 0;
  }

  /* Scalloped valance with gold trim across the top. */
  .valance {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 0;
    right: 0;
    height: max(56px, 9vh);
    background:
      radial-gradient(ellipse 50% 100% at 50% 0, var(--velvet) 0 96%, var(--gold) 97% 99%, transparent 100%)
        0 0 / 180px 100% repeat-x,
      linear-gradient(var(--velvet-dark), var(--velvet)) top / 100% 40% no-repeat;
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.5));
    transition: transform 1s 0.6s cubic-bezier(0.65, 0, 0.25, 1);
  }

  .opening .valance {
    transform: translateY(-110%);
  }

  /* Deco card: navy panel, double gold rule, sunburst on top. */
  .card {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    width: min(28rem, calc(100vw - 2.5rem));
    padding: 1.6rem 2rem 2rem;
    text-align: center;
    background: rgba(5, 16, 30, 0.94);
    border: 1px solid var(--gold);
    outline: 1px solid rgba(226, 196, 110, 0.45);
    outline-offset: 5px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.7);
    transform: translate(-50%, -50%);
    transition:
      opacity 0.4s,
      transform 0.4s;
  }

  .opening .card {
    opacity: 0;
    transform: translate(-50%, -46%) scale(0.97);
  }

  .fan {
    width: 90px;
    color: var(--gold);
  }

  .eyebrow {
    margin: 0.4rem 0 0;
    font: 600 0.72rem/1 'Josefin Sans', sans-serif;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
  }

  h2 {
    margin: 0.4rem 0 1rem;
    font: 400 clamp(2rem, 6vw, 2.8rem) / 1.05 'Limelight', serif;
    letter-spacing: 0.02em;
  }

  .card p:not(.eyebrow) {
    margin: 0 0 0.8rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #c4d7e4;
  }

  button {
    margin-top: 0.8rem;
    padding: 0.85rem 2.6rem 0.75rem;
    appearance: none;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    font: 700 0.85rem/1 'Josefin Sans', sans-serif;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }

  button:hover,
  button:focus-visible {
    background: var(--gold);
    color: #05101e;
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .curtain,
    .valance,
    .card {
      transition: none;
    }
  }
</style>
