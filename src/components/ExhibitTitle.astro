---
/**
 * An exhibit title that plays with "AI": the capital A and I that spell it are highlighted, as in
 * "cArnIvora" or "BonsAI". A title with parentheses keeps the older style instead, where the
 * parenthesized parts are softer so "A(quar)I(um)" reads as AI.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
const parens = title.includes('(');
const parts = title.split(parens ? /(\([^)]*\))/ : /([AI]+)/).filter(Boolean);
---

{
  parts.map((part) =>
    parens ? (part.startsWith('(') ? <span class="aside">{part}</span> : part)
    : /^[AI]+$/.test(part) ? <span class="ai">{part}</span>
    : part,
  )
}

<style>
  .aside {
    opacity: 0.5;
  }

  .ai {
    color: var(--accent, currentColor);
  }
</style>
