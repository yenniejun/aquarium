---
/**
 * An exhibit title that plays with "AI": parenthesized parts are softer, so "A(quar)I(um)" reads
 * as AI, except a parenthesized "(AI)" itself, which is highlighted, as in "Bons(AI)".
 */
interface Props {
  title: string;
}

const parts = Astro.props.title.split(/(\([^)]*\))/).filter(Boolean);
---

{
  parts.map((part) =>
    part === '(AI)' ? <span class="ai">{part}</span> : part.startsWith('(') ? <span class="aside">{part}</span> : part,
  )
}

<style>
  .aside {
    opacity: 0.5;
  }

  .ai {
    color: var(--accent, currentColor);
  }
</style>
