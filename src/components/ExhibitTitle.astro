---
/**
 * An exhibit title that plays with "AI": the capital A and I that spell it are highlighted, as in
 * "AquarIum", "cArnIvora" or "BonsAI".
 */
interface Props {
  title: string;
}

const parts = Astro.props.title.split(/([AI]+)/).filter(Boolean);
---

{parts.map((part) => (/^[AI]+$/.test(part) ? <span class="ai">{part}</span> : part))}

<style>
  .ai {
    color: var(--accent, currentColor);
  }
</style>
