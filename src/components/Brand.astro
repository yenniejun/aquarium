---
import { href } from '../lib/url';

interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;

// Original publication logo from artfish.ai, saved locally to avoid a third-party image request.
// https://substack-post-media.s3.amazonaws.com/public/images/4c6d96a8-9e6c-421e-b411-211798d04fe4_256x256.png
---

<a
  class:list={['brand', { light }]}
  href="https://artfish.ai"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Art Fish Intelligence (opens in a new tab)"
  aria-describedby="artfish-credit"
>
  <img src={href('/artfish-logo.png')} width="256" height="256" alt="" decoding="async" />
  <span class="tooltip" id="artfish-credit" role="tooltip">Created by Art Fish Intelligence</span>
</a>

<style>
  .brand {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 8px;
    border-radius: 12px;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: invert(1);
  }

  .light img {
    filter: none;
  }

  .brand:hover img {
    opacity: 0.75;
  }

  .tooltip {
    position: absolute;
    z-index: 20;
    top: calc(100% + 8px);
    left: 0;
    width: max-content;
    max-width: min(17rem, calc(100vw - 3rem));
    padding: 0.6rem 0.75rem;
    border: 1px solid rgba(158, 195, 220, 0.35);
    border-radius: 8px;
    background: #03101e;
    color: #e6f5ff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    font: 400 0.7rem/1.5 'IBM Plex Mono', monospace;
    letter-spacing: 0.02em;
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
  }

  /* Keep the tooltip open while the pointer crosses the gap or rests on the text. */
  .tooltip::before {
    content: '';
    position: absolute;
    bottom: 100%;
    left: 0;
    width: 100%;
    height: 8px;
  }

  .brand:is(:hover, :focus-visible) .tooltip {
    opacity: 1;
    visibility: visible;
  }

  .brand:focus-visible {
    outline: 2px solid var(--accent, #6fd6f5);
    outline-offset: 4px;
  }
</style>
