---
import { Code } from 'astro:components';
import type { Exhibit } from '../lib/exhibits';
import { getPrompt } from '../lib/exhibits';

interface Props {
  exhibit: Exhibit;
}

const { exhibit } = Astro.props;
const prompt = getPrompt(exhibit);
---

<section id="methodology" class="methodology">
  <h2>Methodology</h2>
  <div class="about">
    {exhibit.intro && <p>{exhibit.intro}</p>}
    <p>
      Every model gets exactly the same prompt, shown below, and every piece is the code that model wrote, running live
      in its own sandbox.
      {exhibit.mode === 'blind' && ' Tanks are shuffled and unlabeled. Click your favorite to vote, and only then see who made what.'}
    </p>
  </div>

  {
    prompt && (
      <figure class="editor">
        <div class="titlebar">
          <span class="dots" aria-hidden="true">
            <i />
            <i />
            <i />
          </span>
          <span class="tab">prompt.md</span>
          <span class="version">v{exhibit.promptVersion}</span>
          <button type="button" data-copy={prompt}>
            Copy
          </button>
        </div>
        <Code code={prompt} lang="md" theme="night-owl" wrap />
        <figcaption class="statusbar">
          <span>Markdown</span>
          <span>{prompt.split('\n').length} lines</span>
          <span class="note">Sent verbatim to every model</span>
        </figcaption>
      </figure>
    )
  }
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  .methodology {
    max-width: 50rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vh, 5rem) 1.25rem 2rem;
  }

  h2 {
    margin: 0 0 1rem;
    font: 400 1.9rem/1.1 var(--title-font, 'Fraunces', serif);
    letter-spacing: 0.02em;
  }

  .about p {
    margin: 0 0 0.8rem;
    color: var(--muted);
  }

  /* An editor window: title bar with a tab, line-numbered code, status bar. */
  .editor {
    margin: 2rem 0 0;
    border: 1px solid #1d3b53;
    border-radius: 10px;
    overflow: hidden;
    background: #011627;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.8);
  }

  .titlebar {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    padding: 0 0.6rem 0 0.9rem;
    background: #0b2942;
    border-bottom: 1px solid #1d3b53;
    font: 500 0.72rem/1 'IBM Plex Mono', monospace;
    color: #8badc1;
  }

  .dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .dots i:nth-child(2) {
    background: #febc2e;
  }

  .dots i:nth-child(3) {
    background: #28c840;
  }

  .tab {
    display: flex;
    align-items: center;
    margin-left: 0.5rem;
    padding: 0.7rem 1rem 0.6rem;
    border-top: 2px solid #7fdbca;
    background: #011627;
    color: #d6deeb;
  }

  .version {
    display: flex;
    align-items: center;
    color: #5f7e97;
  }

  .titlebar button {
    align-self: center;
    margin-left: auto;
    appearance: none;
    padding: 0.35rem 0.8rem;
    border: 1px solid #1d3b53;
    border-radius: 6px;
    background: #011627;
    color: #d6deeb;
    font: inherit;
    cursor: pointer;
  }

  .titlebar button:hover {
    border-color: #7fdbca;
  }

  /* Line numbers via CSS counters; long lines soft-wrap with a hanging indent like an editor. */
  .editor :global(pre) {
    margin: 0;
    padding: 1rem 1.2rem 1.2rem 0;
    border-radius: 0;
    counter-reset: line;
    font: 0.82rem/1.65 'IBM Plex Mono', monospace;
  }

  .editor :global(pre .line) {
    position: relative;
    display: inline-block;
    vertical-align: top;
    width: 100%;
    min-height: 1.65em; /* blank lines are empty spans; keep them a full line tall */
    padding-left: 3.6em;
    counter-increment: line;
  }

  .editor :global(pre .line::before) {
    content: counter(line);
    position: absolute;
    left: 0;
    width: 2.6em;
    text-align: right;
    color: #4b6479;
  }

  .statusbar {
    display: flex;
    gap: 1.2rem;
    padding: 0.4rem 0.9rem;
    background: #0b2942;
    border-top: 1px solid #1d3b53;
    font: 400 0.66rem/1.4 'IBM Plex Mono', monospace;
    color: #5f7e97;
  }

  .statusbar .note {
    margin-left: auto;
  }

  @media (max-width: 600px) {
    .statusbar .note {
      display: none;
    }
  }
</style>
