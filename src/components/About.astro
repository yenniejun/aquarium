---
/**
 * The "?" button in the header and the modal it opens. It's also the welcome: on a first visit
 * it opens by itself (?reset shows it again). Two tabs at a fixed size: About, and the exact
 * prompt every model got. A skin can fill the About tab with its own Welcome (passed as the
 * default slot); otherwise it shows the title and intro.
 */
import { Code } from 'astro:components';
import type { Exhibit } from '../lib/exhibits';
import { getPrompt } from '../lib/exhibits';
import ExhibitTitle from './ExhibitTitle.astro';

interface Props {
  exhibit: Exhibit;
}

const { exhibit } = Astro.props;
const prompt = getPrompt(exhibit);
const piece = exhibit.pieceLabel.toLowerCase();
const key = `museum:welcomed:${exhibit.slug}`;
---

<button class="about-toggle" type="button" aria-haspopup="dialog" aria-label="About this gallery">?</button>
<dialog class="about" aria-labelledby="about-title" tabindex="-1">
  <div class="bar">
    <div class="tabs" role="tablist">
      <button type="button" role="tab" id="about-tab-about" aria-controls="about-panel-about" aria-selected="true">
        About
      </button>
      {
        prompt && (
          <button
            type="button"
            role="tab"
            id="about-tab-prompt"
            aria-controls="about-panel-prompt"
            aria-selected="false"
            tabindex="-1"
          >
            Prompt
          </button>
        )
      }
    </div>
    <form method="dialog">
      <button class="close" aria-label="Close">×</button>
    </form>
  </div>

  <div class="panel welcome" role="tabpanel" id="about-panel-about" aria-labelledby="about-tab-about">
    {
      Astro.slots.has('default') ? (
        <slot />
      ) : (
        <div class="copy">
          <h2 id="about-title">
            <ExhibitTitle title={exhibit.title} />
          </h2>
          {exhibit.intro && <p>{exhibit.intro}</p>}
          {exhibit.mode === 'blind' && <p>Pick your favorite {piece}!</p>}
        </div>
      )
    }
  </div>

  {
    prompt && (
      <div class="panel" role="tabpanel" id="about-panel-prompt" aria-labelledby="about-tab-prompt" hidden>
        <figure class="editor">
          <div class="titlebar">
            <span class="dots" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
            <span class="file">prompt.md</span>
            <span class="version">v{exhibit.promptVersion}</span>
            <button type="button" data-copy={prompt}>
              Copy
            </button>
          </div>
          <Code code={prompt} lang="md" theme="github-light" wrap />
        </figure>
      </div>
    )
  }
</dialog>

{/* Inline so a first-time visitor sees the welcome straight away, not the page and then a popup. */}
<script is:inline define:vars={{ key }}>
  try {
    if (new URLSearchParams(location.search).has('reset')) localStorage.removeItem(key);
    if (!localStorage.getItem(key)) {
      const dialog = document.currentScript.previousElementSibling;
      dialog.showModal();
      dialog.focus(); // the modal itself, not its first tab, so no focus ring on open
      localStorage.setItem(key, '1');
    }
  } catch {}
</script>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.about')!;
  const tabs = [...dialog.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
  };

  document.querySelector('.about-toggle')!.addEventListener('click', () => {
    select(tabs[0]);
    dialog.showModal();
    dialog.focus();
  });
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  for (const [i, tab] of tabs.entries()) {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  }

  for (const button of dialog.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  .about-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    background: rgba(3, 12, 24, 0.85);
    color: #e6f5ff;
    font: 500 0.9rem/1 'IBM Plex Mono', monospace;
    cursor: pointer;
  }

  .about-toggle:hover,
  .about-toggle:focus-visible {
    background: #e6f5ff;
    color: #03101e;
    outline: none;
  }

  /* One fixed size for both tabs; the prompt scrolls inside. */
  .about {
    width: min(44rem, 100vw - 1.5rem);
    height: min(34rem, 100svh - 2rem);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #f7fafc;
    color: #10202e;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .about:focus {
    outline: none;
  }

  .about[open] {
    display: flex;
    flex-direction: column;
    animation: rise 0.25s ease-out;
  }

  .about::backdrop {
    background: rgba(2, 9, 18, 0.55);
    backdrop-filter: blur(4px);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .bar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    padding: 10px 10px 0 12px;
  }

  .tabs {
    display: flex;
    gap: 2px;
  }

  .tabs button,
  .close {
    appearance: none;
    border: 0;
    background: transparent;
    color: #4a6378;
    cursor: pointer;
  }

  .tabs button {
    padding: 7px 12px;
    border-radius: 99px;
    font: 500 0.68rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tabs button:hover {
    background: rgba(3, 16, 30, 0.06);
  }

  .tabs button[aria-selected='true'] {
    background: #03101e;
    color: #f7fafc;
  }

  .close {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font: 400 1.25rem/1 system-ui, sans-serif;
  }

  .close:hover,
  .close:focus-visible {
    background: rgba(3, 16, 30, 0.06);
    color: #03101e;
    outline: none;
  }

  .panel {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 12px;
  }

  .panel[hidden] {
    display: none;
  }

  /* About: a skin's Welcome fills the whole panel. */
  .welcome {
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .copy {
    padding: clamp(1.4rem, 5vh, 2.4rem) clamp(1.25rem, 5vw, 2.6rem);
  }

  .copy h2 {
    margin: 0 0 1rem;
    font: 600 clamp(2rem, 7vw, 2.8rem) / 1.05 system-ui, sans-serif;
  }

  .copy p {
    max-width: 32rem;
    margin: 0 0 0.7rem;
    font-size: 1.15rem;
    line-height: 1.5;
  }

  /* The prompt, in a small editor window. */
  .editor {
    margin: 0;
    border: 1px solid #dbe3ea;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem 0.5rem 0.9rem;
    background: #eef3f7;
    border-bottom: 1px solid #dbe3ea;
    font: 500 0.72rem/1 'IBM Plex Mono', monospace;
    color: #4a6378;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .dots i:nth-child(2) {
    background: #febc2e;
  }

  .dots i:nth-child(3) {
    background: #28c840;
  }

  .file {
    margin-left: 0.4rem;
    color: #10202e;
  }

  .version {
    color: #8a9bab;
  }

  .titlebar button {
    margin-left: auto;
    appearance: none;
    padding: 0.35rem 0.8rem;
    border: 1px solid #cfd9e2;
    border-radius: 6px;
    background: #fff;
    color: #10202e;
    font: inherit;
    cursor: pointer;
  }

  .titlebar button:hover {
    border-color: #03101e;
  }

  /* Line numbers via CSS counters; long lines soft-wrap with a hanging indent like an editor. */
  .editor :global(pre) {
    margin: 0;
    padding: 1rem 1.2rem 1.2rem 0;
    border-radius: 0;
    counter-reset: line;
    font: 0.8rem/1.65 'IBM Plex Mono', monospace;
  }

  .editor :global(pre .line) {
    position: relative;
    display: inline-block;
    vertical-align: top;
    width: 100%;
    min-height: 1.65em; /* blank lines are empty spans; keep them a full line tall */
    padding-left: 3.6em;
    counter-increment: line;
  }

  .editor :global(pre .line::before) {
    content: counter(line);
    position: absolute;
    left: 0;
    width: 2.6em;
    text-align: right;
    color: #a7b4c0;
  }

  @media (prefers-reduced-motion: reduce) {
    .about[open] {
      animation: none;
    }
  }
</style>
