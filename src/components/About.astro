---
/**
 * The header's "Info" and "?" buttons. Hovering "?" (or tapping it, or tabbing to it) shows a
 * small bubble with what the models were told and what to do. "Info" opens a modal with two tabs:
 * the models in this gallery (with links to their makers' pages) and the exact prompt they got.
 * A skin can also pass a Welcome (the default slot): it opens by itself in its own modal on a
 * first visit (?reset shows it again).
 */
import { Code } from 'astro:components';
import type { Exhibit } from '../lib/exhibits';
import { getPieces, getPrompt } from '../lib/exhibits';
import { modelLinks } from '../lib/modelLinks';

interface Props {
  exhibit: Exhibit;
  /** Open the skin's Welcome by itself on a first visit. */
  autoOpen?: boolean;
}

const { exhibit, autoOpen = false } = Astro.props;
const prompt = getPrompt(exhibit);
const piece = exhibit.pieceLabel.toLowerCase();
const key = `museum:welcomed:${exhibit.slug}`;
const welcome = Astro.slots.has('default');

// The models, open weights first, then by maker and name. Never in lineup order: the pieces are in
// lineup order in the page, so that would quietly pair each model with its piece.
const models = getPieces(exhibit)
  .map(({ entry }) => ({
    name: entry.artist,
    maker: entry.provider,
    open: entry.openWeights,
    url: modelLinks[entry.slug],
  }))
  .sort((a, b) => Number(b.open) - Number(a.open) || a.maker.localeCompare(b.maker) || a.name.localeCompare(b.name));
---

<button class="pill info-toggle" type="button" aria-haspopup="dialog">Info</button>
<div class="help">
  <button class="about-toggle" type="button" aria-label="About this gallery" aria-describedby="about-hint" aria-expanded="false">
    ?
  </button>
  <div class="hint" id="about-hint" role="tooltip">
    {exhibit.intro && <p>{exhibit.intro}</p>}
    {exhibit.mode === 'blind' && <p>Select your favorite {piece} to reveal which AI created each one!</p>}
  </div>
</div>

<dialog class="modal info-dialog" aria-label={`About ${exhibit.title}`} tabindex="-1">
  <div class="bar">
    <div class="tabs" role="tablist">
      <button type="button" role="tab" id="info-tab-models" aria-controls="info-panel-models" aria-selected="true">
        Models
      </button>
      {
        prompt && (
          <button type="button" role="tab" id="info-tab-prompt" aria-controls="info-panel-prompt" aria-selected="false" tabindex="-1">
            Prompt
          </button>
        )
      }
    </div>
    <form method="dialog">
      <button class="close" aria-label="Close">×</button>
    </form>
  </div>

  <div class="panel models" role="tabpanel" id="info-panel-models" aria-labelledby="info-tab-models">
    <p class="intro">Every model got the same prompt, word for word.</p>
    <table>
      <thead>
        <tr>
          <th scope="col">Model</th>
          <th scope="col">Lab</th>
          <th scope="col">Weights</th>
        </tr>
      </thead>
      <tbody>
        {
          models.map((m) => (
            <tr>
              <th scope="row">
                {m.url ? (
                  <a href={m.url} target="_blank" rel="noopener">
                    {m.name} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  m.name
                )}
              </th>
              <td>{m.maker}</td>
              <td class:list={{ open: m.open }}>{m.open ? 'Open' : 'Closed'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">
      <b>Open</b> weights: anyone can download the model and run it. <b>Closed</b>: only through its lab's own
      service.
    </p>
  </div>

  {
    prompt && (
      <div class="panel" role="tabpanel" id="info-panel-prompt" aria-labelledby="info-tab-prompt" hidden>
        <figure class="editor">
          <div class="titlebar">
            <span class="dots" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
            <span class="file">prompt.md</span>
            <span class="version">v{exhibit.promptVersion}</span>
            <button type="button" data-copy={prompt}>
              Copy
            </button>
          </div>
          <Code code={prompt} lang="md" theme="github-light" wrap />
        </figure>
      </div>
    )
  }
</dialog>

{
  welcome && (
    <dialog class="modal welcome-dialog" aria-label={`Welcome to ${exhibit.title}`} tabindex="-1">
      <form method="dialog" class="corner">
        <button class="close" aria-label="Close">×</button>
      </form>
      <div class="welcome">
        <slot />
      </div>
    </dialog>
  )
}

{/* Inline so a first-time visitor sees the welcome straight away, not the page and then a popup. */}
{welcome && autoOpen && (
<script is:inline define:vars={{ key }}>
  try {
    if (new URLSearchParams(location.search).has('reset')) localStorage.removeItem(key);
    if (!localStorage.getItem(key)) {
      const dialog = document.currentScript.previousElementSibling;
      dialog.showModal();
      dialog.focus(); // the modal itself, not its close button, so no focus ring on open
      localStorage.setItem(key, '1');
    }
  } catch {}
</script>
)}

<script>
  // The bubble shows on hover and keyboard focus (CSS); a tap or click pins it open until you
  // tap elsewhere or press Escape, since phones can't hover.
  const help = document.querySelector<HTMLElement>('.help')!;
  const toggle = help.querySelector<HTMLButtonElement>('.about-toggle')!;
  const pin = (open: boolean) => {
    help.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle.addEventListener('click', () => pin(!help.classList.contains('open')));
  document.addEventListener('click', (e) => !help.contains(e.target as Node) && pin(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && pin(false));

  const info = document.querySelector<HTMLDialogElement>('dialog.info-dialog')!;
  const tabs = [...info.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
  };
  for (const [i, tab] of tabs.entries()) {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  }
  document.querySelector('.info-toggle')!.addEventListener('click', () => {
    select(tabs[0]);
    info.showModal();
    info.focus();
  });

  // Clicking the backdrop closes either modal.
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog.modal')) {
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('dialog [data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  .about-toggle,
  .pill {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(3, 12, 24, 0.85);
    color: #e6f5ff;
    cursor: pointer;
  }

  .about-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: 50%;
    font: 500 0.9rem/1 'IBM Plex Mono', monospace;
  }

  .pill {
    height: 34px;
    padding: 0 14px;
    border-radius: 99px;
    font: 500 0.68rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-toggle:hover,
  .about-toggle:focus-visible,
  .help.open .about-toggle,
  .pill:hover,
  .pill:focus-visible {
    background: #e6f5ff;
    color: #03101e;
    outline: none;
  }

  /* The bubble under the "?", lined up with its right edge. */
  .help {
    position: relative;
  }

  .hint {
    position: absolute;
    z-index: 20;
    top: calc(100% + 10px);
    right: 0;
    width: min(19rem, 100vw - 2rem);
    padding: 0.9rem 1rem 0.3rem;
    border-radius: 12px;
    background: #f7fafc;
    color: #10202e;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    translate: 0 -4px;
    transition:
      opacity 0.15s,
      translate 0.15s,
      visibility 0.15s;
  }

  /* A little pointer up to the "?". */
  .hint::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 12px;
    width: 12px;
    height: 12px;
    rotate: 45deg;
    background: #f7fafc;
  }

  .help:hover .hint,
  .help:focus-within .hint,
  .help.open .hint {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }

  .hint p {
    margin: 0 0 0.6rem;
    font: 400 0.8rem/1.55 'IBM Plex Mono', monospace;
  }

  /* The prompt and the welcome open as modals. */
  .modal {
    width: min(36rem, 100vw - 1.5rem);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #f7fafc;
    color: #10202e;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .info-dialog {
    height: min(30rem, 100svh - 2rem);
  }

  .welcome-dialog {
    height: min(26rem, 100svh - 2rem);
  }

  .modal:focus {
    outline: none;
  }

  .modal[open] {
    display: flex;
    flex-direction: column;
    animation: rise 0.25s ease-out;
  }

  .modal::backdrop {
    background: rgba(2, 9, 18, 0.55);
    backdrop-filter: blur(4px);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .bar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    padding: 10px 10px 0 18px;
  }

  .tabs {
    display: flex;
    gap: 2px;
  }

  .tabs button {
    padding: 7px 12px;
    appearance: none;
    border: 0;
    border-radius: 99px;
    background: transparent;
    color: #4a6378;
    font: 500 0.68rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .tabs button:hover {
    background: rgba(3, 16, 30, 0.06);
  }

  .tabs button[aria-selected='true'] {
    background: #03101e;
    color: #f7fafc;
  }

  /* The Models tab: two short lists, each model linking to its maker's page. */
  .panel.models {
    padding: 22px 40px 30px;
    font: 400 0.78rem/1.5 'IBM Plex Mono', monospace;
  }

  .models .intro {
    margin: 0 0 1rem;
    color: #4a6378;
  }

  .models table {
    width: 100%;
    border-collapse: collapse;
  }

  .models th,
  .models td {
    padding: 0.35rem 1rem 0.35rem 0;
    border-top: 1px solid #e3eaf0;
    text-align: left;
    vertical-align: top;
    font-weight: 400;
  }

  .models thead th {
    border-top: 0;
    font: 600 0.62rem/1.4 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4a6378;
  }

  .models td {
    color: #4a6378;
  }

  .models td.open {
    color: #1d7a4f;
  }

  .models a {
    color: #0a5f8a;
    text-decoration: none;
  }

  .models a:hover,
  .models a:focus-visible {
    text-decoration: underline;
  }

  .models .note {
    margin: 1.1rem 0 0;
    font-size: 0.7rem;
    color: #6b8296;
  }

  .close {
    width: 30px;
    height: 30px;
    appearance: none;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #4a6378;
    font: 400 1.25rem/1 system-ui, sans-serif;
    cursor: pointer;
  }

  .close:hover,
  .close:focus-visible {
    background: rgba(3, 16, 30, 0.06);
    color: #03101e;
    outline: none;
  }

  /* The welcome's close button floats over its top corner. */
  .corner {
    position: absolute;
    z-index: 3;
    top: 10px;
    right: 10px;
  }

  .panel {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 12px;
  }

  .panel[hidden] {
    display: none;
  }

  .welcome {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  /* The prompt, in a small editor window. */
  .editor {
    margin: 0;
    border: 1px solid #dbe3ea;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem 0.5rem 0.9rem;
    background: #eef3f7;
    border-bottom: 1px solid #dbe3ea;
    font: 500 0.72rem/1 'IBM Plex Mono', monospace;
    color: #4a6378;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .dots i:nth-child(2) {
    background: #febc2e;
  }

  .dots i:nth-child(3) {
    background: #28c840;
  }

  .file {
    margin-left: 0.4rem;
    color: #10202e;
  }

  .version {
    color: #8a9bab;
  }

  .titlebar button {
    margin-left: auto;
    appearance: none;
    padding: 0.35rem 0.8rem;
    border: 1px solid #cfd9e2;
    border-radius: 6px;
    background: #fff;
    color: #10202e;
    font: inherit;
    cursor: pointer;
  }

  .titlebar button:hover {
    border-color: #03101e;
  }

  /* Line numbers via CSS counters; long lines soft-wrap with a hanging indent like an editor. */
  .editor :global(pre) {
    margin: 0;
    padding: 1rem 1.2rem 1.2rem 0;
    border-radius: 0;
    counter-reset: line;
    font: 0.7rem/1.6 'IBM Plex Mono', monospace;
  }

  .editor :global(pre .line) {
    position: relative;
    display: inline-block;
    vertical-align: top;
    width: 100%;
    min-height: 1.65em; /* blank lines are empty spans; keep them a full line tall */
    padding-left: 3.6em;
    counter-increment: line;
  }

  .editor :global(pre .line::before) {
    content: counter(line);
    position: absolute;
    left: 0;
    width: 2.6em;
    text-align: right;
    color: #a7b4c0;
  }

  @media (prefers-reduced-motion: reduce) {
    .modal[open] {
      animation: none;
    }

    .hint {
      transition: none;
    }
  }
</style>
