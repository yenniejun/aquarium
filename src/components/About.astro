---
/**
 * The header's "Info" button. It opens a modal with three tabs: a plain-language About (what the
 * models were told and what to do) for visitors who don't know AI, the models in this gallery (with
 * links to their makers' pages) and the exact prompt they got.
 * A skin can also pass a Welcome (the default slot): it opens by itself in its own modal on a
 * first visit (?reset shows it again).
 */
import { Code } from 'astro:components';
import type { Exhibit } from '../lib/exhibits';
import { getPieces, getPrompt } from '../lib/exhibits';
import { modelLinks } from '../lib/modelLinks';

interface Props {
  exhibit: Exhibit;
  /** Open the skin's Welcome by itself on a first visit. */
  autoOpen?: boolean;
}

const { exhibit, autoOpen = false } = Astro.props;
const prompt = getPrompt(exhibit);
const piece = exhibit.pieceLabel.toLowerCase();
const key = `museum:welcomed:${exhibit.slug}`;
const welcome = Astro.slots.has('default');
// What the models were asked to do, taken from the intro: "Each AI model is told to grow one bonsai
// tree." -> "grow one bonsai tree." An intro that doesn't follow that pattern is simply left out.
const task = exhibit.intro?.match(/^Each AI model is told to (.+)$/)?.[1];

// The models, open weights first, then by maker and name. Never in lineup order: the pieces are in
// lineup order in the page, so that would quietly pair each model with its piece.
const models = getPieces(exhibit)
  .map(({ entry }) => ({
    name: entry.artist,
    maker: entry.provider,
    open: entry.openWeights,
    url: modelLinks[entry.slug],
  }))
  .sort((a, b) => Number(b.open) - Number(a.open) || a.maker.localeCompare(b.maker) || a.name.localeCompare(b.name));
---

<button class="pill info-toggle" type="button" aria-haspopup="dialog">Info</button>

<dialog class="modal info-dialog" aria-label={`About ${exhibit.title}`} tabindex="-1">
  <div class="bar">
    <div class="tabs" role="tablist">
      <button type="button" role="tab" id="info-tab-about" aria-controls="info-panel-about" aria-selected="true">
        About
      </button>
      <button type="button" role="tab" id="info-tab-models" aria-controls="info-panel-models" aria-selected="false" tabindex="-1">
        Models
      </button>
      {
        prompt && (
          <button type="button" role="tab" id="info-tab-prompt" aria-controls="info-panel-prompt" aria-selected="false" tabindex="-1">
            Prompt
          </button>
        )
      }
    </div>
    <form method="dialog">
      <button class="close" aria-label="Close">×</button>
    </form>
  </div>

  {/* For someone who has never used AI: no jargon, and nothing that only holds for some galleries. */}
  <div class="panel about" role="tabpanel" id="info-panel-about" aria-labelledby="info-tab-about">
    <p class="lead">An art show where every piece was made by AI.</p>
    <p>{models.length} different AI models were given the same instructions{task ? ` to ${task}` : '.'}</p>
    <p>
      Everything you see was made by the AI writing code.
      {exhibit.mode === 'blind' && ` Select your favorite ${piece} to find out which AI made each one!`}
    </p>
    <p class="more">
      The <b>Models</b> tab lists every AI model in this gallery.
      {prompt && <><br />The <b>Prompt</b> tab shows the exact instructions they got.</>}
    </p>
  </div>

  <div class="panel models" role="tabpanel" id="info-panel-models" aria-labelledby="info-tab-models" hidden>
    <p class="intro">Every model got the same prompt, word for word.</p>
    <table>
      <thead>
        <tr>
          <th scope="col">Model</th>
          <th scope="col">Lab</th>
          <th scope="col">Weights</th>
        </tr>
      </thead>
      <tbody>
        {
          models.map((m) => (
            <tr>
              <th scope="row">
                {m.url ? (
                  <a href={m.url} target="_blank" rel="noopener">
                    {m.name} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  m.name
                )}
              </th>
              <td>{m.maker}</td>
              <td class:list={{ open: m.open }}>{m.open ? 'Open' : 'Closed'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">
      <b>Open</b> weights: anyone can download the model and run it. <b>Closed</b>: only through its lab's own
      service.
    </p>
  </div>

  {
    prompt && (
      <div class="panel" role="tabpanel" id="info-panel-prompt" aria-labelledby="info-tab-prompt" hidden>
        <figure class="editor">
          <div class="titlebar">
            <span class="dots" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
            <span class="file">prompt.md</span>
            <span class="version">v{exhibit.promptVersion}</span>
            <button type="button" data-copy={prompt}>
              Copy
            </button>
          </div>
          <Code code={prompt} lang="md" theme="github-light" wrap />
        </figure>
      </div>
    )
  }
</dialog>

{
  welcome && (
    <dialog class="modal welcome-dialog" aria-label={`Welcome to ${exhibit.title}`} tabindex="-1">
      <form method="dialog" class="corner">
        <button class="close" aria-label="Close">×</button>
      </form>
      <div class="welcome">
        <slot />
      </div>
    </dialog>
  )
}

{/* Inline so a first-time visitor sees the welcome straight away, not the page and then a popup. */}
{welcome && autoOpen && (
<script is:inline define:vars={{ key }}>
  try {
    if (new URLSearchParams(location.search).has('reset')) localStorage.removeItem(key);
    if (!localStorage.getItem(key)) {
      const dialog = document.currentScript.previousElementSibling;
      dialog.showModal();
      dialog.focus(); // the modal itself, not its close button, so no focus ring on open
      localStorage.setItem(key, '1');
    }
  } catch {}
</script>
)}



<style>
  .pill {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(3, 12, 24, 0.85);
    color: #e6f5ff;
    cursor: pointer;
    height: 34px;
    padding: 0 14px;
    border-radius: 99px;
    font: 500 0.68rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pill:hover,
  .pill:focus-visible {
    background: #e6f5ff;
    color: #03101e;
    outline: none;
  }

  /* The prompt and the welcome open as modals. */
  .modal {
    width: min(36rem, 100vw - 1.5rem);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #f7fafc;
    color: #10202e;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .info-dialog {
    height: min(30rem, 100svh - 2rem);
  }

  .welcome-dialog {
    height: min(26rem, 100svh - 2rem);
  }

  .modal:focus {
    outline: none;
  }

  .modal[open] {
    display: flex;
    flex-direction: column;
    animation: rise 0.25s ease-out;
  }

  .modal::backdrop {
    background: rgba(2, 9, 18, 0.55);
    backdrop-filter: blur(4px);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .bar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    padding: 10px 10px 0 18px;
  }

  .tabs {
    display: flex;
    gap: 2px;
  }

  .tabs button {
    padding: 7px 12px;
    appearance: none;
    border: 0;
    border-radius: 99px;
    background: transparent;
    color: #4a6378;
    font: 500 0.68rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .tabs button:hover {
    background: rgba(3, 16, 30, 0.06);
  }

  .tabs button[aria-selected='true'] {
    background: #03101e;
    color: #f7fafc;
  }

  /* The About tab: a few short paragraphs, a touch larger than the rest so they're easy to read. */
  .panel.about {
    padding: 14px 40px 18px;
    font: 400 0.8rem/1.65 'IBM Plex Mono', monospace;
  }

  .about p {
    margin: 0 0 0.85rem;
  }

  .about .lead {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .about .more {
    margin-top: 1.1rem;
    font-size: 0.72rem;
    color: #6b8296;
  }

  .about b {
    font-weight: 600;
    color: #4a6378;
  }

  /* The Models tab: two short lists, each model linking to its maker's page. */
  .panel.models {
    padding: 12px 40px 18px;
    font: 400 0.72rem/1.5 'IBM Plex Mono', monospace;
  }

  .models .intro {
    margin: 0 0 0.6rem;
    color: #4a6378;
  }

  .models table {
    width: 100%;
    border-collapse: collapse;
  }

  .models th,
  .models td {
    padding: 0.22rem 1rem 0.22rem 0;
    border-top: 1px solid #e3eaf0;
    text-align: left;
    vertical-align: top;
    font-weight: 400;
  }

  .models thead th {
    border-top: 0;
    font: 600 0.62rem/1.4 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4a6378;
  }

  .models td {
    color: #4a6378;
  }

  .models td.open {
    color: #1d7a4f;
  }

  .models a {
    color: #0a5f8a;
    text-decoration: none;
  }

  .models a:hover,
  .models a:focus-visible {
    text-decoration: underline;
  }

  .models .note {
    margin: 0.8rem 0 0;
    font-size: 0.66rem;
    color: #6b8296;
  }

  .close {
    width: 30px;
    height: 30px;
    appearance: none;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #4a6378;
    font: 400 1.25rem/1 system-ui, sans-serif;
    cursor: pointer;
  }

  .close:hover,
  .close:focus-visible {
    background: rgba(3, 16, 30, 0.06);
    color: #03101e;
    outline: none;
  }

  /* The welcome's close button floats over its top corner. */
  .corner {
    position: absolute;
    z-index: 3;
    top: 10px;
    right: 10px;
  }

  .panel {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 12px;
  }

  .panel[hidden] {
    display: none;
  }

  .welcome {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  /* The prompt, in a small editor window. */
  .editor {
    margin: 0;
    border: 1px solid #dbe3ea;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem 0.5rem 0.9rem;
    background: #eef3f7;
    border-bottom: 1px solid #dbe3ea;
    font: 500 0.72rem/1 'IBM Plex Mono', monospace;
    color: #4a6378;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .dots i:nth-child(2) {
    background: #febc2e;
  }

  .dots i:nth-child(3) {
    background: #28c840;
  }

  .file {
    margin-left: 0.4rem;
    color: #10202e;
  }

  .version {
    color: #8a9bab;
  }

  .titlebar button {
    margin-left: auto;
    appearance: none;
    padding: 0.35rem 0.8rem;
    border: 1px solid #cfd9e2;
    border-radius: 6px;
    background: #fff;
    color: #10202e;
    font: inherit;
    cursor: pointer;
  }

  .titlebar button:hover {
    border-color: #03101e;
  }

  /* Line numbers via CSS counters; long lines soft-wrap with a hanging indent like an editor. */
  .editor :global(pre) {
    margin: 0;
    padding: 1rem 1.2rem 1.2rem 0;
    border-radius: 0;
    counter-reset: line;
    font: 0.7rem/1.6 'IBM Plex Mono', monospace;
  }

  .editor :global(pre .line) {
    position: relative;
    display: inline-block;
    vertical-align: top;
    width: 100%;
    min-height: 1.65em; /* blank lines are empty spans; keep them a full line tall */
    padding-left: 3.6em;
    counter-increment: line;
  }

  .editor :global(pre .line::before) {
    content: counter(line);
    position: absolute;
    left: 0;
    width: 2.6em;
    text-align: right;
    color: #a7b4c0;
  }

  @media (prefers-reduced-motion: reduce) {
    .modal[open] {
      animation: none;
    }
  }
</style>
