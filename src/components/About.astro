---
/**
 * The header's "?" and "Prompt" buttons. Hovering "?" (or tapping it, or tabbing to it) shows a
 * small bubble with what the models were told and what to do; "Prompt" opens the exact prompt
 * every model got. A skin can also pass a Welcome (the default slot): it opens by itself in its
 * own modal on a first visit (?reset shows it again).
 */
import { Code } from 'astro:components';
import type { Exhibit } from '../lib/exhibits';
import { getPrompt } from '../lib/exhibits';

interface Props {
  exhibit: Exhibit;
  /** Open the skin's Welcome by itself on a first visit. */
  autoOpen?: boolean;
}

const { exhibit, autoOpen = false } = Astro.props;
const prompt = getPrompt(exhibit);
const piece = exhibit.pieceLabel.toLowerCase();
const key = `museum:welcomed:${exhibit.slug}`;
const welcome = Astro.slots.has('default');
---

{
  prompt && (
    <button class="pill prompt-toggle" type="button" aria-haspopup="dialog">
      Prompt
    </button>
  )
}
<div class="help">
  <button class="about-toggle" type="button" aria-label="About this gallery" aria-describedby="about-hint" aria-expanded="false">
    ?
  </button>
  <div class="hint" id="about-hint" role="tooltip">
    {exhibit.intro && <p>{exhibit.intro}</p>}
    {exhibit.mode === 'blind' && <p>Select your favorite {piece} to reveal which AI created each one!</p>}
  </div>
</div>

{
  prompt && (
    <dialog class="modal prompt-dialog" aria-label="The prompt" tabindex="-1">
      <div class="bar">
        <span class="heading">Prompt</span>
        <form method="dialog">
          <button class="close" aria-label="Close">×</button>
        </form>
      </div>
      <div class="panel">
        <figure class="editor">
          <div class="titlebar">
            <span class="dots" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
            <span class="file">prompt.md</span>
            <span class="version">v{exhibit.promptVersion}</span>
            <button type="button" data-copy={prompt}>
              Copy
            </button>
          </div>
          <Code code={prompt} lang="md" theme="github-light" wrap />
        </figure>
      </div>
    </dialog>
  )
}

{
  welcome && (
    <dialog class="modal welcome-dialog" aria-label={`Welcome to ${exhibit.title}`} tabindex="-1">
      <form method="dialog" class="corner">
        <button class="close" aria-label="Close">×</button>
      </form>
      <div class="welcome">
        <slot />
      </div>
    </dialog>
  )
}

{/* Inline so a first-time visitor sees the welcome straight away, not the page and then a popup. */}
{welcome && autoOpen && (
<script is:inline define:vars={{ key }}>
  try {
    if (new URLSearchParams(location.search).has('reset')) localStorage.removeItem(key);
    if (!localStorage.getItem(key)) {
      const dialog = document.currentScript.previousElementSibling;
      dialog.showModal();
      dialog.focus(); // the modal itself, not its close button, so no focus ring on open
      localStorage.setItem(key, '1');
    }
  } catch {}
</script>
)}

<script>
  // The bubble shows on hover and keyboard focus (CSS); a tap or click pins it open until you
  // tap elsewhere or press Escape, since phones can't hover.
  const help = document.querySelector<HTMLElement>('.help')!;
  const toggle = help.querySelector<HTMLButtonElement>('.about-toggle')!;
  const pin = (open: boolean) => {
    help.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle.addEventListener('click', () => pin(!help.classList.contains('open')));
  document.addEventListener('click', (e) => !help.contains(e.target as Node) && pin(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && pin(false));

  const promptDialog = document.querySelector<HTMLDialogElement>('dialog.prompt-dialog');
  document.querySelector('.prompt-toggle')?.addEventListener('click', () => {
    promptDialog!.showModal();
    promptDialog!.focus();
  });

  // Clicking the backdrop closes either modal.
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog.modal')) {
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('dialog [data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  .about-toggle,
  .pill {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(3, 12, 24, 0.85);
    color: #e6f5ff;
    cursor: pointer;
  }

  .about-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: 50%;
    font: 500 0.9rem/1 'IBM Plex Mono', monospace;
  }

  .pill {
    height: 34px;
    padding: 0 14px;
    border-radius: 99px;
    font: 500 0.68rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-toggle:hover,
  .about-toggle:focus-visible,
  .help.open .about-toggle,
  .pill:hover,
  .pill:focus-visible {
    background: #e6f5ff;
    color: #03101e;
    outline: none;
  }

  /* The bubble under the "?", lined up with its right edge. */
  .help {
    position: relative;
  }

  .hint {
    position: absolute;
    z-index: 20;
    top: calc(100% + 10px);
    right: 0;
    width: min(19rem, 100vw - 2rem);
    padding: 0.9rem 1rem 0.3rem;
    border-radius: 12px;
    background: #f7fafc;
    color: #10202e;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    translate: 0 -4px;
    transition:
      opacity 0.15s,
      translate 0.15s,
      visibility 0.15s;
  }

  /* A little pointer up to the "?". */
  .hint::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 12px;
    width: 12px;
    height: 12px;
    rotate: 45deg;
    background: #f7fafc;
  }

  .help:hover .hint,
  .help:focus-within .hint,
  .help.open .hint {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }

  .hint p {
    margin: 0 0 0.6rem;
    font: 400 0.8rem/1.55 'IBM Plex Mono', monospace;
  }

  /* The prompt and the welcome open as modals. */
  .modal {
    width: min(36rem, 100vw - 1.5rem);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #f7fafc;
    color: #10202e;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .prompt-dialog {
    height: min(30rem, 100svh - 2rem);
  }

  .welcome-dialog {
    height: min(26rem, 100svh - 2rem);
  }

  .modal:focus {
    outline: none;
  }

  .modal[open] {
    display: flex;
    flex-direction: column;
    animation: rise 0.25s ease-out;
  }

  .modal::backdrop {
    background: rgba(2, 9, 18, 0.55);
    backdrop-filter: blur(4px);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .bar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    padding: 10px 10px 0 18px;
  }

  .heading {
    font: 500 0.68rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4a6378;
  }

  .close {
    width: 30px;
    height: 30px;
    appearance: none;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #4a6378;
    font: 400 1.25rem/1 system-ui, sans-serif;
    cursor: pointer;
  }

  .close:hover,
  .close:focus-visible {
    background: rgba(3, 16, 30, 0.06);
    color: #03101e;
    outline: none;
  }

  /* The welcome's close button floats over its top corner. */
  .corner {
    position: absolute;
    z-index: 3;
    top: 10px;
    right: 10px;
  }

  .panel {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 12px;
  }

  .welcome {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  /* The prompt, in a small editor window. */
  .editor {
    margin: 0;
    border: 1px solid #dbe3ea;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem 0.5rem 0.9rem;
    background: #eef3f7;
    border-bottom: 1px solid #dbe3ea;
    font: 500 0.72rem/1 'IBM Plex Mono', monospace;
    color: #4a6378;
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .dots i:nth-child(2) {
    background: #febc2e;
  }

  .dots i:nth-child(3) {
    background: #28c840;
  }

  .file {
    margin-left: 0.4rem;
    color: #10202e;
  }

  .version {
    color: #8a9bab;
  }

  .titlebar button {
    margin-left: auto;
    appearance: none;
    padding: 0.35rem 0.8rem;
    border: 1px solid #cfd9e2;
    border-radius: 6px;
    background: #fff;
    color: #10202e;
    font: inherit;
    cursor: pointer;
  }

  .titlebar button:hover {
    border-color: #03101e;
  }

  /* Line numbers via CSS counters; long lines soft-wrap with a hanging indent like an editor. */
  .editor :global(pre) {
    margin: 0;
    padding: 1rem 1.2rem 1.2rem 0;
    border-radius: 0;
    counter-reset: line;
    font: 0.7rem/1.6 'IBM Plex Mono', monospace;
  }

  .editor :global(pre .line) {
    position: relative;
    display: inline-block;
    vertical-align: top;
    width: 100%;
    min-height: 1.65em; /* blank lines are empty spans; keep them a full line tall */
    padding-left: 3.6em;
    counter-increment: line;
  }

  .editor :global(pre .line::before) {
    content: counter(line);
    position: absolute;
    left: 0;
    width: 2.6em;
    text-align: right;
    color: #a7b4c0;
  }

  @media (prefers-reduced-motion: reduce) {
    .modal[open] {
      animation: none;
    }

    .hint {
      transition: none;
    }
  }
</style>
