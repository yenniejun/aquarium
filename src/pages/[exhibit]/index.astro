---
import ExhibitPage from '../../components/ExhibitPage.astro';
import { exhibitPath, getExhibits, type Exhibit } from '../../lib/exhibits';
import { href } from '../../lib/url';

export function getStaticPaths() {
  return getExhibits().map((exhibit) => ({ params: { exhibit: exhibit.slug }, props: { exhibit } }));
}

const { exhibit } = Astro.props as { exhibit: Exhibit };
const home = exhibitPath(exhibit) === '/';
---

{
  home ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0; url=${href('/')}`} />
        <link rel="canonical" href={href('/')} />
        <title>{exhibit.title}</title>
      </head>
      <body>
        <a href={href('/')}>{exhibit.title}</a>
      </body>
    </html>
  ) : (
    <ExhibitPage exhibit={exhibit} />
  )
}
