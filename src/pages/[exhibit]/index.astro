---
import Base from '../../layouts/Base.astro';
import { getExhibits, getPieces, toView, type Exhibit } from '../../lib/exhibits';
import { href } from '../../lib/url';
import { skins } from '../../skins';

export function getStaticPaths() {
  return getExhibits().map((exhibit) => ({ params: { exhibit: exhibit.slug }, props: { exhibit } }));
}

const { exhibit } = Astro.props as { exhibit: Exhibit };
const pieces = getPieces(exhibit).map((piece, i) => toView(exhibit, piece, i));
const Room = skins[exhibit.skin];
const blind = exhibit.mode === 'blind';
---

<Base skin={exhibit.skin} title={exhibit.title} description={exhibit.intro ?? exhibit.tagline}>
  <div
    class="exhibit"
    data-exhibit={exhibit.slug}
    data-state={blind ? 'voting' : 'revealed'}
    data-reveal-url={blind ? href(`/reveal/${exhibit.slug}.json`) : undefined}
  >
    <Room exhibit={exhibit} pieces={pieces} />
  </div>
  <p slot="footer">
    {exhibit.intro}{' '}
    {
      blind && (
        <span data-vote-hint data-done="Thanks for voting! Now you can see who made what.">
          Click your favorite to find out who made what.
        </span>
      )
    }
  </p>
</Base>

<script>
  import '../../scripts/voting';
</script>

<style>
  /* Layout belongs to the skin's Room; this wrapper only carries state. */
  .exhibit {
    display: contents;
  }
</style>
