---
import '../styles/global.css';
import SideNav from '../components/SideNav.astro';
import { site } from '../site';
import { href } from '../lib/url';

interface Props {
  skin: string;
  title?: string;
  description?: string;
}

const { skin, title, description = site.blurb } = Astro.props;
const favicon = `data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#0b2a4a"/><path d="M5 16c4-6 12-6 16 0-4 6-12 6-16 0zm16 0 6-5v10z" fill="#ffb347"/><circle cx="10" cy="15" r="1.5" fill="#0b2a4a"/></svg>`,
)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Fredoka:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..600&family=IBM+Plex+Mono:wght@400;500;600&family=Josefin+Sans:wght@400;600;700&family=Limelight&display=swap"
    />
  </head>
  <body data-skin={skin}>
    <header class="site-header">
      <a class="logo" href={href('/')} aria-label={`${site.name}, home`} title={site.name}>
        {/* A museum front: pediment with a round window, four columns, two steps. */}
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.5 11 16 3.5 28.5 11Z"></path>
            <circle cx="16" cy="8.4" r="1.3"></circle>
            <path d="M5 13.5h22M8 16v8M13 16v8M19 16v8M24 16v8M5 26.5h22M3 29h26"></path>
          </g>
        </svg>
      </a>
      <div class="header-tools">
        <slot name="header" />
        <SideNav />
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <slot name="footer" />
      <p>Every piece on this site is code written by an AI model.</p>
    </footer>
  </body>
</html>
