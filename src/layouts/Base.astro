---
import '../styles/global.css';
import SideNav from '../components/SideNav.astro';
import { site } from '../site';

interface Props {
  skin: string;
  title?: string;
  description?: string;
}

const { skin, title, description = site.blurb } = Astro.props;
const favicon = `data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#0b2a4a"/><path d="M5 16c4-6 12-6 16 0-4 6-12 6-16 0zm16 0 6-5v10z" fill="#ffb347"/><circle cx="10" cy="15" r="1.5" fill="#0b2a4a"/></svg>`,
)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? site.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    {
      import.meta.env.PROD && site.umamiWebsiteId && (
        <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={site.umamiWebsiteId} />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Gluten:wght@400;600&family=Fraunces:ital,opsz,wght@0,9..144,400..800;1,9..144,400..600&family=IBM+Plex+Mono:wght@400;500;600&family=Josefin+Sans:wght@400;600;700&display=swap"
    />
  </head>
  <body data-skin={skin}>
    <header class="site-header">
      <div class="header-tools">
        <slot name="header" />
        <SideNav />
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <slot name="footer" />
      <p>Every piece on this site is code written by an AI model.</p>
    </footer>
  </body>
</html>
