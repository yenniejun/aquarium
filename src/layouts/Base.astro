---
import '../styles/global.css';
import SideNav from '../components/SideNav.astro';
import Brand from '../components/Brand.astro';
import { fontsUrl } from '../lib/fonts';
import { site } from '../site';

interface Props {
  skin: string;
  /** The exhibit's display, for its fonts. */
  variant?: string;
  title?: string;
  description?: string;
  gallery?: string;
}

const { skin, variant, title, description = site.blurb, gallery } = Astro.props;
const favicon = `data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#0b2a4a"/><path d="M5 16c4-6 12-6 16 0-4 6-12 6-16 0zm16 0 6-5v10z" fill="#ffb347"/><circle cx="10" cy="15" r="1.5" fill="#0b2a4a"/></svg>`,
)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? site.name}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url).href} />
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    {
      import.meta.env.PROD && site.umamiWebsiteId && (
        <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={site.umamiWebsiteId} />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsUrl(skin, variant)} />
  </head>
  <body data-skin={skin}>
    <div data-gallery-page={gallery} data-skin={skin} data-title={title ?? site.name} data-description={description}>
      <header class="site-header">
        <Brand light={skin === 'page' || variant === 'niche' || variant === 'terrarium'} />
        <div class="header-tools">
          <slot name="header" />
          <SideNav />
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <a class="credit" href="https://artfish.ai" target="_blank" rel="noopener">
          created by <b><span class="ai">A</span>rt fish <span class="ai">I</span>ntelligence</b> <em>♥</em>
        </a>
      </footer>
    </div>
  </body>
</html>
