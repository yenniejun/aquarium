---
/**
 * The cabinet skin: a gallery of curiosities. The exhibit's `variant` picks both the display each
 * piece sits in (see ./Frame.astro) and the room around them: a potting shed for bell jars, a paper
 * alcove wall for bonsai, a brick wall at night for windows, apothecary shelves, a greenhouse, and
 * a planetarium dome.
 */
import type { Exhibit, PieceView } from '../../lib/exhibits';
import ExhibitTitle from '../../components/ExhibitTitle.astro';
import Frame from './Frame.astro';

interface Props {
  exhibit: Exhibit;
  pieces: PieceView[];
}

const { exhibit, pieces } = Astro.props;
const variant = exhibit.variant ?? 'niche';

// Terrarium night sky: stars scattered once at build time (seeded, so every build matches).
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 140 }, () => {
  const size = rand() < 0.15 ? 2 : 1;
  return `${(rand() * 100).toFixed(2)}vw ${(rand() * 100).toFixed(2)}vh 0 ${size - 1}px rgba(255, 255, 255, ${(0.35 + rand() * 0.6).toFixed(2)})`;
}).join(', ');
const fireflies = Array.from({ length: 46 }, () =>
  `${(rand() * 100).toFixed(2)}vw ${(30 + rand() * 70).toFixed(2)}vh ${(2 + rand() * 4).toFixed(1)}px ${(rand() * 1.5).toFixed(1)}px rgba(255, ${Math.round(200 + rand() * 40)}, 140, ${(0.4 + rand() * 0.5).toFixed(2)})`,
).join(', ');

// Planetarium sky: stars of every size, brightness and tint, thicker along a Milky Way band that
// runs from bottom left to top right, and three sets of bright stars that twinkle out of step.
const gauss = () => Math.sqrt(-2 * Math.log(rand() || 1e-9)) * Math.cos(2 * Math.PI * rand());
const tints = ['255, 255, 255', '205, 218, 255', '255, 238, 214'];
const skyStars = Array.from({ length: 460 }, (_, i) => {
  const x = rand() * 100;
  const y = i % 5 < 2 ? 85 - 0.7 * x + gauss() * 7 : rand() * 100;
  const big = rand() < 0.07;
  const tint = tints[Math.floor(rand() * tints.length)];
  return `${x.toFixed(2)}vw ${y.toFixed(2)}vh 0 ${big ? 0.6 : 0}px rgba(${tint}, ${(0.2 + rand() * (big ? 0.7 : 0.5)).toFixed(2)})`;
}).join(', ');
// Mermaids: specks drifting in the water (marine snow), scattered once at build time.
const marineSnow = Array.from({ length: 80 }, () =>
  `${(rand() * 100).toFixed(2)}vw ${(rand() * 100).toFixed(2)}vh ${(rand() * 2).toFixed(1)}px ${(rand() * 0.8).toFixed(1)}px rgba(205, 238, 245, ${(0.15 + rand() * 0.35).toFixed(2)})`,
).join(', ');
const brightStars = [0, 1, 2].map(() =>
  Array.from({ length: 8 }, () => `${(rand() * 100).toFixed(2)}vw ${(rand() * 100).toFixed(2)}vh 3px 1px rgba(255, 248, 230, 0.85)`).join(', '),
);
---

<div class="room" data-variant={variant}>
  {
    variant === 'terrarium' && (
      <>
        <div class="night" aria-hidden="true">
          <i class="stars" style={`box-shadow: ${stars}`} />
        </div>
        <div class="sun" aria-hidden="true" />
        <div class="moon" aria-hidden="true" />
      </>
    )
  }
  {variant === 'tarot' && <i class="fireflies" aria-hidden="true" style={`box-shadow: ${fireflies}`} />}
  {variant === 'bottle' && <i class="snow" aria-hidden="true" style={`box-shadow: ${marineSnow}`} />}
  {
    variant === 'porthole' && (
      <div class="sky" aria-hidden="true">
        <i class="stars" style={`box-shadow: ${skyStars}`} />
        {brightStars.map((s) => (
          <i class="stars bright" style={`box-shadow: ${s}`} />
        ))}
      </div>
    )
  }
  <section class="screen">
    <h1><ExhibitTitle title={exhibit.title} /></h1>
    <ol class="pieces" data-pieces>
      {
        pieces.map((piece, i) => (
          <li data-piece={piece.id} data-pending={piece.status === 'pending' ? '' : undefined} style={`--i: ${i}`}>
            <Frame piece={piece} variant={variant} />
          </li>
        ))
      }
    </ol>
  </section>
</div>

<script>
  import { daylight, moonArc, sunArc, timeOfDay } from './day';

  // Terrarium: the sky follows the shared day, the same clock every piece is told to use.
  const room = document.querySelector<HTMLElement>('.room[data-variant="terrarium"]');
  if (room) {
    const tick = () => {
      const t = timeOfDay();
      room.style.setProperty('--light', daylight(t).toFixed(3));
      room.style.setProperty('--sun', sunArc(t).toFixed(4));
      room.style.setProperty('--moon', moonArc(t).toFixed(4));
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>

<style>
  :global(body[data-skin='cabinet']) {
    --title-font: 'Gluten', system-ui, sans-serif;
    --plaque-font: 'Josefin Sans', sans-serif;
    background: #111;
  }

  /* The header floats over the room; the page is just the room, like the aquarium. */
  :global(body[data-skin='cabinet'] .site-header) {
    position: absolute;
    inset: 0 0 auto;
  }

  .room {
    --ink: #f1efe2;
    --accent: #c8e66a;
    min-height: 100vh;
    min-height: 100svh;
    color: var(--ink);
  }

  /* The room's wall covers the whole window, including the strip behind the menu. */
  .room::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--wall);
  }

  .screen {
    padding: 0.55rem clamp(1rem, 4vw, 3rem) 3.5rem;
  }

  h1 {
    margin: 0 0 clamp(1.4rem, 5vh, 2.6rem);
    text-align: center;
    font: 600 clamp(1.6rem, 3.2vw, 2.4rem) / 1.1 var(--title-font);
    letter-spacing: 0.02em;
  }

  /* Light walls get a darker credit at the bottom of the page. */
  :global(body:has(.room:is([data-variant='niche'], [data-variant='terrarium']))) {
    --footer-ink: rgba(30, 24, 16, 0.72);
    --footer-ai: #0a78a8;
  }

  /* Each gallery's title has its own typeface (a few more are set with their rooms below). */
  [data-variant='belljar'] h1 {
    font: 700 clamp(1.9rem, 3.8vw, 2.8rem) / 1.1 'Cinzel Decorative', serif;
  }

  [data-variant='niche'] h1 {
    font: 700 clamp(2rem, 4vw, 3rem) / 1.1 'Shippori Mincho', serif;
  }

  [data-variant='shelf'] h1 {
    font: 700 clamp(2.1rem, 4.2vw, 3.1rem) / 1.1 'Almendra', serif;
  }

  [data-variant='porthole'] h1 {
    font: 400 clamp(2.2rem, 4.4vw, 3.2rem) / 1.1 'Poiret One', sans-serif;
  }

  [data-variant='specimen'] h1 {
    font: italic 500 clamp(2.2rem, 4.4vw, 3.2rem) / 1.1 'Fraunces', serif;
  }

  [data-variant='terrarium'] h1 {
    font: 700 clamp(1.9rem, 3.8vw, 2.8rem) / 1.1 'Comfortaa', sans-serif;
  }

  [data-variant='window'] h1 {
    font: 400 clamp(2rem, 4vw, 3rem) / 1.1 'Monoton', sans-serif;
  }

  /* Three across (two on phones); each display shape gets a width that keeps rows balanced.
     Rows line up at the top, so jars, stands and shelves sit level however long the labels are. */
  .pieces {
    --cols: 3;
    --w: 210px;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, var(--w)));
    justify-content: center;
    align-items: start;
    gap: clamp(2rem, 6vh, 3.5rem) clamp(1.5rem, 4vw, 3.5rem);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  [data-variant='niche'] .pieces,
  [data-variant='porthole'] .pieces {
    --w: 230px;
  }

  [data-variant='shelf'] .pieces {
    --w: 190px;
  }

  /* Phones: two across, and the header gets its own row above the title, like the aquarium's. */
  @media (max-width: 699px) {
    .pieces {
      --cols: 2;
    }

    :global(body[data-skin='cabinet'] .site-header) {
      position: static;
    }
  }

  /* Rooms, one per display. */

  /* Bell jars: a potting shed, warm lamp light on green planks. */
  [data-variant='belljar'] {
    --accent: #c8e66a;
    --wall:
      radial-gradient(80% 45% at 50% 0%, rgba(255, 214, 150, 0.2), transparent 70%),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.16) 0 2px, transparent 2px 118px),
      linear-gradient(#24402f, #10201a);
  }

  /* Bonsai: a calm washi-paper wall. */
  [data-variant='niche'] {
    --ink: #2b2620;
    --accent: #b5543c;
    --wall:
      radial-gradient(60% 40% at 50% 8%, #fffaf0, transparent 75%),
      repeating-linear-gradient(97deg, rgba(120, 100, 70, 0.04) 0 1px, transparent 1px 7px),
      linear-gradient(#efe8da, #e2d9c6);
  }

  /* Windows: a brick wall at night. */
  [data-variant='window'] {
    --ink: #f3ece0;
    --accent: #ffcf6e;
    --wall:
      radial-gradient(90% 60% at 50% 110%, rgba(255, 190, 110, 0.12), transparent 70%),
      linear-gradient(rgba(0, 0, 0, 0.32) 2px, transparent 2px) 0 0 / 100% 26px,
      linear-gradient(#2c1a22, #160d14);
  }

  /* Apothecary: dark wood paneling by candlelight. */
  [data-variant='shelf'] {
    --ink: #f0e2c4;
    --accent: #e0aa52;
    --wall:
      radial-gradient(70% 50% at 50% 20%, rgba(255, 170, 80, 0.16), transparent 70%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.025) 0 3px, transparent 3px 11px),
      linear-gradient(#2d1c12, #150c07);
  }

  /* Terrarium: a misty glasshouse wall under a sky that follows the shared day (--light, --sun). */
  [data-variant='terrarium'] {
    --light: 1;
    --sun: 0.5;
    --moon: -1;
    --ink: color-mix(in srgb, #12261b calc(var(--light) * 100%), #e6f1ea);
    --accent: #2e7d4f;
    --wall:
      linear-gradient(90deg, rgba(255, 255, 255, 0.28) 2px, transparent 2px) 0 0 / 150px 100%,
      linear-gradient(rgba(255, 255, 255, 0.2) 2px, transparent 2px) 0 0 / 100% 190px,
      radial-gradient(70% 50% at 50% 0%, rgba(255, 255, 255, 0.45), transparent 70%),
      linear-gradient(#c3dccb, #86ab97);
  }

  /* Fungarium: dark wood paneling, like an old natural-history museum: vertical planks, each a
     slightly different tone, with fine grain, seams between them, and a warm lamp glow from above. */
  [data-variant='specimen'] {
    --ink: #f1e9da;
    --accent: #b7e07a;
    --wall:
      radial-gradient(80% 50% at 50% -5%, rgba(255, 214, 150, 0.14), transparent 70%),
      radial-gradient(70% 45% at 50% 115%, rgba(0, 0, 0, 0.45), transparent 70%),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.45) 0 2px, rgba(255, 220, 170, 0.05) 2px 3px, transparent 3px 140px),
      repeating-linear-gradient(90deg, transparent 0 7px, rgba(0, 0, 0, 0.07) 7px 8px, transparent 8px 19px, rgba(255, 230, 190, 0.035) 19px 20px, transparent 20px 31px),
      repeating-linear-gradient(90deg, #33241a 0 140px, #2c1f16 140px 280px, #382819 280px 420px, #2f2117 420px 560px);
  }

  [data-variant='specimen'] .pieces {
    padding-top: 24px;
  }

  /* Waffle cart: one big chalkboard menu, chalk dust and all. */
  [data-variant='menu'] {
    --ink: #f4f1e8;
    --accent: #f2c86b;
    --wall:
      radial-gradient(40% 30% at 20% 30%, rgba(255, 255, 255, 0.05), transparent 70%),
      radial-gradient(35% 25% at 80% 70%, rgba(255, 255, 255, 0.04), transparent 70%),
      radial-gradient(circle, rgba(255, 255, 255, 0.05) 0 1px, transparent 1.5px) 0 0 / 7px 9px,
      linear-gradient(#2f3833, #232a26);
  }

  [data-variant='menu'] h1 {
    font: 700 clamp(2.2rem, 4.4vw, 3.2rem) / 1 'Caveat', cursive;
  }

  [data-variant='menu'] .pieces {
    --w: 250px;
    row-gap: clamp(1.5rem, 4vh, 2.5rem);
  }

  /* Carnival: inside the big top, stripes fanning down from the peak, lights strung across. */
  [data-variant='bigtop'] {
    --ink: #fff4dc;
    --accent: #f2c14e;
    --wall:
      radial-gradient(circle, #ffe9a8 0 3px, rgba(255, 220, 120, 0.35) 4px, transparent 9px) 0 70px / 64px 30px repeat-x,
      radial-gradient(70% 55% at 50% 45%, rgba(255, 210, 120, 0.12), transparent 70%),
      linear-gradient(rgba(25, 6, 12, 0.62), rgba(12, 3, 6, 0.85)),
      repeating-conic-gradient(from -90deg at 50% -25%, #a8132a 0 5deg, #efe4cf 5deg 10deg);
  }

  [data-variant='bigtop'] h1 {
    font: 400 clamp(2.2rem, 4.6vw, 3.4rem) / 1 'Limelight', 'Gluten', serif;
    letter-spacing: 0.04em;
    color: #fff4dc;
    text-shadow:
      0 3px 0 #5a0a16,
      0 0 18px rgba(0, 0, 0, 0.55);
  }

  /* Fairies: tarot cards on a fortune-teller's velvet table, gold dust in the air. */
  [data-variant='tarot'] {
    --ink: #f1e4c3;
    --accent: #e6c478;
    --wall:
      radial-gradient(55% 45% at 50% 35%, rgba(255, 190, 110, 0.12), transparent 75%),
      repeating-radial-gradient(circle at 50% 120%, rgba(255, 255, 255, 0.015) 0 2px, transparent 2px 6px),
      radial-gradient(120% 90% at 50% 40%, #3a1a3e, #1a0b1f 70%);
  }

  [data-variant='tarot'] h1 {
    font: 400 clamp(2rem, 4vw, 3rem) / 1.05 'IM Fell English', serif;
    letter-spacing: 0.04em;
  }

  [data-variant='tarot'] .pieces {
    --w: 220px;
  }

  .fireflies {
    position: fixed;
    left: 0;
    top: 0;
    z-index: -1;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    animation: fireflies 4s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes fireflies {
    to {
      opacity: 0.45;
      translate: 6px -10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fireflies {
      animation: none;
    }
  }

  /* Nightmare: field-guide pages on a dark desk under lamplight. */
  [data-variant='fieldguide'] {
    --ink: #e8dcc6;
    --accent: #c2413a;
    --wall:
      radial-gradient(55% 45% at 50% 30%, rgba(255, 170, 80, 0.16), transparent 75%),
      repeating-linear-gradient(176deg, rgba(0, 0, 0, 0.12) 0 2px, transparent 2px 9px),
      linear-gradient(#2b1a12, #140c08);
  }

  [data-variant='fieldguide'] h1 {
    font: 400 clamp(2rem, 4vw, 3rem) / 1.05 'Metamorphous', serif;
  }

  [data-variant='fieldguide'] .pieces {
    --w: 230px;
  }

  /* Night falls over the glasshouse as the light goes. */
  .night {
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: calc(1 - var(--light));
    background: linear-gradient(#0a1428, #16283a 70%, #1d3a33);
    pointer-events: none;
  }

  /* One tiny dot whose box-shadows are the scattered stars. */
  .stars {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    border-radius: 50%;
  }

  /* The sun rises on the left, arcs over the room and sets on the right. */
  .sun {
    position: fixed;
    z-index: -1;
    left: calc(8% + var(--sun) * 84%);
    top: calc(82% - sin(var(--sun) * 180deg) * 60%);
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff6d6 0 30%, #ffd77a 55%, rgba(255, 200, 90, 0) 72%);
    box-shadow: 0 0 80px 30px rgba(255, 214, 120, 0.35);
    opacity: clamp(0, min(var(--sun), 1 - var(--sun)) * 20, 1);
    translate: -50% -50%;
    pointer-events: none;
  }

  /* The moon follows the same arc through the night. */
  .moon {
    position: fixed;
    z-index: -1;
    left: calc(8% + var(--moon) * 84%);
    top: calc(82% - sin(var(--moon) * 180deg) * 60%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 36%, #fbfaf2, #dcdccf 60%, #b9bcb4);
    box-shadow:
      inset -9px -6px 0 rgba(150, 160, 170, 0.35),
      0 0 50px 14px rgba(200, 215, 255, 0.22);
    opacity: clamp(0, min(var(--moon), 1 - var(--moon)) * 20, 1);
    translate: -50% -50%;
    pointer-events: none;
  }

  [data-variant='terrarium']:not([style*='--sun']) :is(.sun, .moon) {
    opacity: 0;
  }

  /* Planetarium: a night-sky dome. */
  /* Mermaids in bottles: underwater, with light from the surface breaking into dapples near the
     top, the blue deepening below, and specks drifting in the water (.snow). */
  [data-variant='bottle'] {
    --ink: #f2fbff;
    --accent: #ffd2c2;
    --wall:
      radial-gradient(120% 40% at 50% -10%, rgba(170, 235, 245, 0.3), transparent 60%),
      radial-gradient(16% 5% at 18% 7%, rgba(205, 245, 255, 0.12), transparent 70%),
      radial-gradient(12% 4% at 44% 4%, rgba(205, 245, 255, 0.1), transparent 70%),
      radial-gradient(14% 5% at 66% 9%, rgba(205, 245, 255, 0.11), transparent 70%),
      radial-gradient(20% 6% at 88% 5%, rgba(205, 245, 255, 0.09), transparent 70%),
      radial-gradient(70% 35% at 50% 112%, rgba(2, 16, 28, 0.65), transparent 70%),
      linear-gradient(#10637a 0%, #0b4560 35%, #072d45 70%, #04192a 100%);
  }

  .snow {
    position: fixed;
    z-index: -1;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    animation: drift 18s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes drift {
    to {
      translate: 6px -14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .snow {
      animation: none;
    }
  }

  [data-variant='bottle'] h1 {
    font: 400 clamp(2rem, 4vw, 3rem) / 1.15 'Rye', serif;
  }

  /* Planetarium: a dome of night sky; the stars themselves are in .sky. */
  [data-variant='porthole'] {
    --ink: #e9ecff;
    --accent: #a9b8ff;
    --wall:
      linear-gradient(159deg, transparent 38%, rgba(170, 180, 255, 0.07) 47%, rgba(255, 225, 240, 0.05) 53%, transparent 62%),
      radial-gradient(35% 28% at 80% 18%, rgba(140, 90, 200, 0.12), transparent 70%),
      radial-gradient(30% 25% at 15% 75%, rgba(70, 120, 200, 0.1), transparent 70%),
      radial-gradient(120% 80% at 50% 0%, #1d2b5c, #070b1d 70%);
  }

  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .sky .bright {
    animation: twinkle 3.1s ease-in-out infinite alternate;
  }

  .sky .bright:nth-child(3) {
    animation-duration: 4.7s;
    animation-delay: -1.3s;
  }

  .sky .bright:nth-child(4) {
    animation-duration: 6.3s;
    animation-delay: -2.9s;
  }

  @keyframes twinkle {
    from {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky .bright {
      animation: none;
    }
  }
</style>
