---
import type { PieceView } from '../../lib/exhibits';

interface Props {
  piece: PieceView;
}

const { piece } = Astro.props;
const note = { pending: 'work in progress', dummy: 'placeholder', final: null }[piece.status];
const corners = ['tl', 'tr', 'br', 'bl'];
---

<figure class="artwork">
  <div class="lamp" aria-hidden="true"></div>
  <div class="frame">
    {
      corners.map((corner) => (
        <svg class={`corner ${corner}`} viewBox="0 0 48 48" aria-hidden="true">
          <path
            fill="url(#gilt)"
            d="M2 2h40c-3 2-8 3-13 3-6 0-9 2-12 5s-5 6-5 12c0 5-1 10-3 13 0 0-1 2-2 2-1 0-2-2-2-2zm6 6c4-1 8 0 9 3s-1 6-4 6-4-3-2-5"
          />
          <circle cx="7" cy="7" r="3.2" fill="url(#gilt)" />
          <path
            fill="none"
            stroke="url(#gilt)"
            stroke-width="2"
            stroke-linecap="round"
            d="M20 6c5 1 9 4 8 8s-6 4-7 1M6 20c1 5 4 9 8 8s4-6 1-7"
          />
        </svg>
      ))
    }
    <div class="beads">
      <div class="mat">
        <div class="canvas">
          <iframe
            src={piece.src}
            title={`${piece.label}: ${piece.title}`}
            sandbox="allow-scripts"
            loading="lazy"
            referrerpolicy="no-referrer"></iframe>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="label">
    <span class="title">{piece.title}</span>
    <span class="artist">{piece.artist ?? 'Artist withheld'}</span>
    {piece.medium && <span class="medium">{piece.medium}</span>}
    <span class="number">
      <span data-label>{piece.label}</span>
      {note && <span class="note">{note}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .artwork {
    position: relative;
    isolation: isolate;
    margin: 0;
  }

  /* Brass picture light, casting a warm pool on the wall behind the frame. */
  .lamp {
    position: relative;
    width: 40%;
    height: 11px;
    margin: 0 auto 16px;
    border-radius: 3px 3px 12px 12px / 3px 3px 9px 9px;
    background: linear-gradient(#f6e2a0, #b98d36 55%, #6e5014);
    box-shadow: 0 2px 3px rgba(0, 0, 0, 0.5);
  }

  .lamp::before {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 3px;
    height: 17px;
    margin-left: -1.5px;
    background: linear-gradient(90deg, #6e5014, #e5c56e, #6e5014);
  }

  .lamp::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 60%;
    left: -70%;
    right: -70%;
    height: 340px;
    pointer-events: none;
    background: radial-gradient(ellipse 50% 100% at 50% 0%, rgba(255, 234, 180, 0.24), transparent 72%);
  }

  /* Carved, gilded molding: gradient body plus stacked bevel shadows. */
  .frame {
    position: relative;
    padding: 7%;
    background: linear-gradient(
      135deg,
      #6b4e14 0%,
      #e6c364 14%,
      #a77b27 30%,
      #f6e3a0 46%,
      #b3872f 60%,
      #e9ca72 78%,
      #6e5115 100%
    );
    box-shadow:
      0 0 0 2px #3d2c09,
      0 28px 40px -14px rgba(0, 0, 0, 0.8),
      inset 0 0 0 2px rgba(255, 240, 190, 0.75),
      inset 0 0 0 5px #7d5b1b,
      inset 0 0 0 7px #d8b45a,
      inset 0 0 26px 4px rgba(70, 45, 0, 0.55);
  }

  .corner {
    position: absolute;
    width: 21%;
    filter: drop-shadow(1px 2px 1px rgba(40, 25, 0, 0.55));
  }

  .tl {
    top: -2.5%;
    left: -2.5%;
  }

  .tr {
    top: -2.5%;
    right: -2.5%;
    transform: scaleX(-1);
  }

  .br {
    bottom: -2.5%;
    right: -2.5%;
    transform: scale(-1);
  }

  .bl {
    bottom: -2.5%;
    left: -2.5%;
    transform: scaleY(-1);
  }

  /* Bead-and-reel band: a dotted border does the beading. */
  .beads {
    padding: 3px;
    border: 4px dotted #f5e1a2;
    background: linear-gradient(135deg, #7d5a1b, #d4ae55 50%, #6e5014);
    box-shadow:
      0 0 0 1px rgba(60, 40, 5, 0.6),
      inset 0 0 0 1px rgba(60, 40, 5, 0.6);
  }

  .mat {
    padding: 9%;
    background: #efe7d2;
    box-shadow:
      inset 3px 4px 8px rgba(0, 0, 0, 0.45),
      inset -1px -1px 0 rgba(255, 255, 255, 0.6);
  }

  .canvas {
    position: relative;
    aspect-ratio: 1;
    background: #f7f3ea;
    box-shadow:
      0 0 0 1px rgba(60, 40, 10, 0.35),
      0 1px 4px rgba(0, 0, 0, 0.3);
  }

  .canvas iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Museum wall label. */
  .label {
    display: grid;
    gap: 1px;
    width: max-content;
    max-width: 88%;
    margin: 1.6rem auto 0;
    padding: 0.7rem 1rem 0.75rem;
    color: #2a2620;
    background: #f8f5ec;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.4);
  }

  .title {
    font: italic 600 1.15rem/1.2 'Cormorant Garamond', serif;
  }

  .artist {
    font: 500 1rem/1.3 'Cormorant Garamond', serif;
  }

  .medium {
    font: 400 0.68rem/1.5 'IBM Plex Mono', monospace;
    color: #6a6252;
  }

  .number {
    margin-top: 0.3rem;
    font: 500 0.6rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a8170;
  }

  .note {
    margin-left: 0.8em;
    color: #a3372b;
  }
</style>
