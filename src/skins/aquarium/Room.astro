---
import type { Exhibit, PieceView } from '../../lib/exhibits';
import Frame from './Frame.astro';
import Viewer from './Viewer.astro';
import ExhibitTitle from '../../components/ExhibitTitle.astro';

interface Props {
  exhibit: Exhibit;
  pieces: PieceView[];
}

const { exhibit, pieces } = Astro.props;
---

<div class="room">
  <div class="rays" aria-hidden="true"></div>
  <div class="motes" aria-hidden="true"></div>
  {/* The first screen: title and all the tanks. Everything else scrolls below. */}
  <section class="screen">
    <h1><ExhibitTitle title={exhibit.title} /></h1>
    <div class="stage">
      <ol class="pieces" data-pieces>
        {
          pieces.map((piece, i) => (
            <li data-piece={piece.id} data-pending={piece.status === 'pending' ? '' : undefined} style={`--i: ${i}`}>
              <Frame piece={piece} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <Viewer />
</div>

<style>
  :global(body[data-skin='aquarium']) {
    --bg: #03101e;
    --ink: #e6f5ff;
    --muted: #86aac4;
    --accent: #6fd6f5;
    --rule: rgba(140, 200, 240, 0.25);
    /* Gluten for the title and the welcome; Josefin Sans caps on the brass plaques. */
    --title-font: 'Gluten', system-ui, sans-serif;
    --plaque-font: 'Josefin Sans', sans-serif;
    background:
      radial-gradient(110% 60% at 50% -5%, #1c5d90 0%, #0c2d50 40%, transparent 80%),
      linear-gradient(#071a2e 0, #03101e 100vh);
  }

  /* The site header floats over the first screen so the title can share its row. */
  :global(body[data-skin='aquarium'] .site-header) {
    position: absolute;
    inset: 0 0 auto;
  }

  /* The page is just the room; what the footer would say lives in the "?" modal. */
  :global(body[data-skin='aquarium'] .site-footer) {
    display: none;
  }

  .room {
    position: relative;
    isolation: isolate;
    overflow-x: clip; /* the light rays are wider than the page */
  }

  /* The title plus the first two rows of tanks fill the first screen; the rest are below the fold. */
  .screen {
    --title-size: clamp(1.6rem, 3.2vw, 2.4rem);
    --title-top: 0.55rem;
    --title-gap: clamp(0.8rem, 2.5vh, 1.4rem);
    --foot: clamp(0.8rem, 2.5vh, 1.6rem);
    padding: var(--title-top) clamp(1rem, 3vw, 2rem) var(--foot);
  }

  h1 {
    margin: 0 0 var(--title-gap);
    text-align: center;
    font: 600 var(--title-size) / 1.1 var(--title-font);
    letter-spacing: 0.02em;
    text-shadow: 0 0 30px rgba(111, 214, 245, 0.35);
  }

  .stage {
    container-type: inline-size;
    display: grid;
    justify-items: center;
  }

  /* Tanks are --ratio wide (4:3) and --tank-h tall, plus fixed --chrome underneath (hood, rim,
     cabinet). Pick the largest --tank-h that fits --cols across and two rows above the fold.
     If width is the limit, the leftover height (--slack) goes above row 1 and below row 2, so
     the first two rows sit centered on the first screen and row 3 starts just past it. */
  .pieces {
    --cols: 3;
    --ratio: 1.3333;
    --gap-x: clamp(1rem, 2.2vw, 2.25rem);
    --gap-y: clamp(1.4rem, 3.5vh, 2.4rem);
    --chrome: 66px;
    --fold: calc(100svh - var(--title-top) - var(--title-size) * 1.1 - var(--title-gap) - var(--foot));
    --tank-h: min(
      (100cqw - (var(--cols) - 1) * var(--gap-x)) / var(--cols) / var(--ratio),
      (var(--fold) - var(--gap-y)) / 2 - var(--chrome),
      330px
    );
    --slack: max(0px, (var(--fold) - 2 * (var(--tank-h) + var(--chrome)) - var(--gap-y)) / 2);
    list-style: none;
    margin: 0;
    padding: var(--slack) 0 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), calc(var(--tank-h) * var(--ratio)));
    grid-template-rows: auto calc(var(--tank-h) + var(--chrome) + var(--slack));
    align-items: start;
    gap: var(--gap-y) var(--gap-x);
  }

  /* Portrait screens: two big columns, scrolling. */
  @media (max-aspect-ratio: 9/10) {
    .pieces {
      --cols: 2;
      --tank-h: min((100cqw - var(--gap-x)) / 2 / var(--ratio), 330px);
      --slack: 0px;
      grid-template-rows: none;
    }
  }

  /* Phones and short windows: the header scrolls away too. */
  @media (max-width: 699px), (max-height: 519px) {
    :global(body[data-skin='aquarium'] .site-header) {
      position: static;
    }

    .screen {
      padding-top: 0;
    }

    .pieces {
      --cols: 2;
      --tank-h: calc((100cqw - var(--gap-x)) / 2 / var(--ratio));
      --slack: 0px;
      grid-template-rows: none;
    }
  }

  @media (max-width: 699px) and (orientation: landscape), (max-height: 519px) and (orientation: landscape) {
    .pieces {
      --cols: 3;
      --tank-h: calc((100cqw - 2 * var(--gap-x)) / 3 / var(--ratio));
    }
  }

  /* Light coming down through the water. */
  .rays {
    position: absolute;
    inset: -10% -20% auto;
    height: 70vh;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(
      100deg,
      transparent 0 70px,
      rgba(160, 225, 255, 0.055) 70px 120px,
      transparent 120px 210px,
      rgba(160, 225, 255, 0.035) 210px 240px
    );
    mask-image: linear-gradient(to bottom, #000, transparent 90%);
    transform-origin: 50% 0;
    animation: sway 16s ease-in-out infinite alternate;
  }

  .motes {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(circle, rgba(200, 235, 255, 0.35) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgba(200, 235, 255, 0.2) 0 1px, transparent 1.5px);
    background-size:
      140px 160px,
      90px 110px;
    animation: drift 40s linear infinite;
  }

  @keyframes sway {
    from {
      transform: skewX(-7deg);
    }
    to {
      transform: skewX(7deg);
    }
  }

  @keyframes drift {
    to {
      background-position:
        0 -800px,
        40px -1100px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rays,
    .motes {
      animation: none;
    }
  }
</style>
