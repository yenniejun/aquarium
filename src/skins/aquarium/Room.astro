---
import type { Exhibit, PieceView } from '../../lib/exhibits';
import Frame from './Frame.astro';

interface Props {
  exhibit: Exhibit;
  pieces: PieceView[];
}

const { exhibit, pieces } = Astro.props;
---

<div class="room">
  <div class="rays" aria-hidden="true"></div>
  <div class="motes" aria-hidden="true"></div>
  <h1>{exhibit.title}</h1>
  <div class="stage">
    <ol class="pieces" data-pieces>
      {
        pieces.map((piece, i) => (
          <li data-piece={piece.id} style={`--i: ${i}`}>
            <Frame piece={piece} />
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  :global(body[data-skin='aquarium']) {
    --bg: #03101e;
    --ink: #e6f5ff;
    --muted: #86aac4;
    --accent: #6fd6f5;
    --rule: rgba(140, 200, 240, 0.25);
    background:
      radial-gradient(110% 60% at 50% -5%, #1c5d90 0%, #0c2d50 40%, transparent 80%),
      linear-gradient(#071a2e, #03101e 60%);
  }

  /* Fit mode: header, room and footer share exactly one screen, and the tanks size
     themselves from whatever space is left (see --tank below). */
  :global(body[data-skin='aquarium']) {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100vh;
    height: 100svh;
  }

  :global(body[data-skin='aquarium'] main) {
    display: grid;
    min-height: 0;
  }

  /* The site header floats over the room so the title can share its row. */
  :global(body[data-skin='aquarium'] .site-header) {
    position: absolute;
    inset: 0 0 auto;
  }

  :global(body[data-skin='aquarium'] main) {
    grid-row: 2;
  }

  :global(body[data-skin='aquarium'] .site-footer) {
    grid-row: 3;
  }

  :global(body[data-skin='aquarium'] .site-footer) {
    padding: 0.4rem 1rem 0.9rem;
    font-size: 0.68rem;
  }

  .room {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-height: 0;
    padding: 0 clamp(1rem, 3vw, 2rem) 0.75rem;
  }

  h1 {
    margin: 0.6rem 0 clamp(0.8rem, 2.5vh, 1.4rem);
    text-align: center;
    font: 700 clamp(1.6rem, 3.2vw, 2.4rem) / 1 'Fraunces', serif;
    letter-spacing: -0.02em;
    text-shadow: 0 0 30px rgba(111, 214, 245, 0.35);
  }

  .stage {
    container-type: size;
    min-height: 0;
    display: grid;
    place-items: center;
  }

  /* Each tank is a square of side --tank plus fixed chrome (hood, rim, cabinet) underneath.
     Pick the largest --tank that fits --cols x --rows of them in the stage. */
  .pieces {
    --cols: 3;
    --rows: 2;
    --gap-x: clamp(1rem, 2.5vw, 2.5rem);
    --gap-y: clamp(1.4rem, 3.5vh, 2.5rem);
    --chrome: 82px;
    --tank: min(
      (100cqw - (var(--cols) - 1) * var(--gap-x)) / var(--cols),
      (100cqh - (var(--rows) - 1) * var(--gap-y)) / var(--rows) - var(--chrome),
      440px
    );
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--tank));
    gap: var(--gap-y) var(--gap-x);
  }

  /* Tall screens fit more tank in 2 columns x 3 rows. */
  @media (max-aspect-ratio: 2/3) {
    .pieces {
      --cols: 2;
      --rows: 3;
    }
  }

  /* Phones and short windows: stop fitting to the screen and just scroll. */
  @media (max-width: 699px), (max-height: 519px) {
    :global(body[data-skin='aquarium']) {
      display: flex;
      height: auto;
    }

    :global(body[data-skin='aquarium'] .site-header) {
      position: static;
    }

    h1 {
      margin-top: 0;
    }

    .stage {
      container-type: inline-size;
    }

    .pieces {
      --cols: 2;
      --tank: min((100cqw - var(--gap-x)) / 2, 440px);
    }
  }

  @media (max-width: 699px) and (orientation: landscape), (max-height: 519px) and (orientation: landscape) {
    .pieces {
      --cols: 3;
      --tank: min((100cqw - 2 * var(--gap-x)) / 3, 440px);
    }
  }

  /* Light coming down through the water. */
  .rays {
    position: absolute;
    inset: -10% -20% 35%;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(
      100deg,
      transparent 0 70px,
      rgba(160, 225, 255, 0.055) 70px 120px,
      transparent 120px 210px,
      rgba(160, 225, 255, 0.035) 210px 240px
    );
    mask-image: linear-gradient(to bottom, #000, transparent 90%);
    transform-origin: 50% 0;
    animation: sway 16s ease-in-out infinite alternate;
  }

  .motes {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(circle, rgba(200, 235, 255, 0.35) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgba(200, 235, 255, 0.2) 0 1px, transparent 1.5px);
    background-size:
      140px 160px,
      90px 110px;
    animation: drift 40s linear infinite;
  }

  @keyframes sway {
    from {
      transform: skewX(-7deg);
    }
    to {
      transform: skewX(7deg);
    }
  }

  @keyframes drift {
    to {
      background-position:
        0 -800px,
        40px -1100px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rays,
    .motes {
      animation: none;
    }
  }
</style>
