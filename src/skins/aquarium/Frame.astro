---
import type { PieceView } from '../../lib/exhibits';

interface Props {
  piece: PieceView;
}

const { piece } = Astro.props;
const note = { pending: 'awaiting arrival', dummy: 'placeholder', final: null }[piece.status];
---

<figure class="tank">
  <div class="hood" aria-hidden="true"></div>
  <div class="glass">
    <iframe
      src={piece.src}
      title={`${piece.label}: ${piece.title}`}
      sandbox="allow-scripts"
      loading="lazy"
      referrerpolicy="no-referrer"></iframe>
    <a class="open" href={piece.src} target="_blank" rel="noopener" aria-label={`Open ${piece.label} full size`}>⤢</a>
  </div>
  <div class="rim" aria-hidden="true"></div>
  <div class="cabinet">
    <figcaption class="plaque">
      <span class="label" data-label>{piece.label}</span>
      <span class="title">{piece.title}</span>
      <span class="artist">{piece.artist ?? '· · ·'}</span>
    </figcaption>
  </div>
  {
    (piece.medium || note) && (
      <p class="meta">
        {piece.medium}
        {note && <span class="note">{note}</span>}
      </p>
    )
  }
</figure>

<style>
  .tank {
    margin: 0;
  }

  /* Black hood with the light strip glowing underneath it. */
  .hood {
    position: relative;
    height: 16px;
    margin: 0 -6px;
    border-radius: 7px 7px 2px 2px;
    background: linear-gradient(#3b414b, #15181d 70%, #0b0d10);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .hood::after {
    content: '';
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: #eaffff;
    box-shadow: 0 0 14px 4px rgba(190, 240, 255, 0.55);
  }

  .glass {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #0a2a40;
    box-shadow:
      0 0 0 1px #05080b,
      0 0 60px -10px rgba(90, 190, 255, 0.35);
  }

  .glass iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Light from the hood, glare on the glass, and the green tint of thick glass edges.
     pointer-events: none so tanks that react to the pointer still get it. */
  .glass::before,
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .glass::before {
    background:
      linear-gradient(to bottom, rgba(225, 255, 255, 0.2), transparent 16%),
      linear-gradient(
        115deg,
        transparent 0 10%,
        rgba(255, 255, 255, 0.09) 10% 15%,
        transparent 15% 19%,
        rgba(255, 255, 255, 0.05) 19% 21%,
        transparent 21%
      );
  }

  .glass::after {
    box-shadow:
      inset 0 0 0 4px rgba(130, 210, 195, 0.32),
      inset 0 0 0 5px rgba(255, 255, 255, 0.14),
      inset 0 0 36px rgba(0, 25, 40, 0.55);
  }

  .open {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(3, 16, 30, 0.6);
    color: var(--ink);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .glass:hover .open,
  .open:focus-visible {
    opacity: 1;
  }

  .rim {
    height: 11px;
    margin: 0 -6px;
    border-radius: 2px 2px 3px 3px;
    background: linear-gradient(#22262c, #0b0d10);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* Wooden stand with a brass plaque. */
  .cabinet {
    display: grid;
    place-items: center;
    margin: 0 3%;
    padding: 12px 10px 16px;
    border-radius: 0 0 4px 4px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.4), transparent 9%, transparent 91%, rgba(0, 0, 0, 0.4)),
      repeating-linear-gradient(92deg, rgba(255, 220, 180, 0.025) 0 2px, transparent 2px 7px),
      linear-gradient(#3d2b1e, #21160e);
    box-shadow:
      inset 0 8px 10px -6px rgba(0, 0, 0, 0.8),
      0 24px 40px -18px rgba(0, 0, 0, 0.9);
  }

  .plaque {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 3px;
    min-width: 66%;
    padding: 7px 22px 8px;
    border-radius: 3px;
    text-align: center;
    color: #3a2709;
    text-shadow: 0 1px 0 rgba(255, 240, 200, 0.55);
    background: linear-gradient(160deg, #8c6424, #f1d27f 36%, #b78a36 52%, #e8c56c 72%, #8a6322);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3),
      0 2px 3px rgba(0, 0, 0, 0.6);
  }

  /* Screws */
  .plaque::before,
  .plaque::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff3c4, #7a5518 70%);
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.4);
  }

  .plaque::before {
    left: 7px;
  }

  .plaque::after {
    right: 7px;
  }

  .label {
    font: 600 0.6rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .title {
    font: 600 1rem/1.15 'Fraunces', serif;
  }

  .artist {
    font: 500 0.68rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.06em;
  }

  .meta {
    margin: 0.9rem 0 0;
    text-align: center;
    font: 400 0.7rem/1.4 'IBM Plex Mono', monospace;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .note {
    margin-left: 0.6em;
    padding: 1px 8px;
    border: 1px solid var(--rule);
    border-radius: 99px;
    color: var(--accent);
  }
</style>
