---
import type { PieceView } from '../../lib/exhibits';

interface Props {
  piece: PieceView;
}

const { piece } = Astro.props;
const empty = piece.status === 'pending';
---

<div class:list={['tank', { empty }]} role="group" aria-label={piece.title}>
  <div class="hood" aria-hidden="true">
    <span class="badge">♥ your pick</span>
  </div>
  <div class="glass">
    <iframe
      src={piece.src}
      title={piece.title}
      sandbox="allow-scripts"
      tabindex="-1"
      loading="lazy"
      referrerpolicy="no-referrer"></iframe>
    <a class="open" href={piece.src} data-expand={piece.title} aria-label={`Look closer at ${piece.title}`}>⤢</a>
  </div>
  <div class="rim" aria-hidden="true"></div>
  <button
    class="cabinet"
    type="button"
    data-vote
    disabled={empty}
    aria-label={empty ? 'Empty tank, awaiting arrival' : `Pick ${piece.title} as your favorite`}
  >
    <span class="plaque">
      <span class="name">{piece.title}</span>
      <span class="who">
        <span class="artist" data-artist>{piece.artist}</span>
        <span class="medium" data-medium>{piece.medium}</span>
      </span>
      {!empty && <span class="hint" aria-hidden="true">♥ pick this one</span>}
    </span>
  </button>
</div>

<style>
  .tank {
    position: relative;
  }

  /* Black hood with the light strip glowing underneath it. */
  .hood {
    position: relative;
    height: 12px;
    margin: 0 -5px;
    border-radius: 6px 6px 2px 2px;
    background: linear-gradient(#3b414b, #15181d 70%, #0b0d10);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .hood::after {
    content: '';
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: #eaffff;
    box-shadow: 0 0 14px 4px rgba(190, 240, 255, 0.55);
  }

  /* "Your pick" tag that pops up on the hood of the tank you voted for. */
  .badge {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 4px;
    padding: 3px 10px 4px;
    border-radius: 99px;
    white-space: nowrap;
    font: 600 0.62rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3a2709;
    background: linear-gradient(160deg, #f6dc8c, #d9a93f);
    box-shadow: 0 2px 10px rgba(255, 200, 90, 0.5);
    transform: translateX(-50%) scale(0);
    transition: transform 0.45s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  :global([data-picked]) .badge {
    transform: translateX(-50%) scale(1);
  }

  .glass {
    position: relative;
    aspect-ratio: var(--ratio, 4 / 3);
    overflow: hidden;
    background: #0a2a40;
    box-shadow:
      0 0 0 1px #05080b,
      0 0 50px -10px rgba(90, 190, 255, 0.35);
    transition: box-shadow 0.4s;
  }

  :global([data-picked]) .glass {
    box-shadow:
      0 0 0 1px #05080b,
      0 0 0 3px rgba(246, 220, 140, 0.8),
      0 0 50px -6px rgba(255, 210, 110, 0.6);
  }

  .glass iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Light from the hood, glare on the glass, and the green tint of thick glass edges.
     pointer-events: none so tanks that react to the pointer still get it. */
  .glass::before,
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .glass::before {
    background:
      linear-gradient(to bottom, rgba(225, 255, 255, 0.2), transparent 16%),
      linear-gradient(
        115deg,
        transparent 0 10%,
        rgba(255, 255, 255, 0.09) 10% 14%,
        transparent 14% 17%,
        rgba(255, 255, 255, 0.05) 17% 19%,
        transparent 19%
      );
  }

  .glass::after {
    box-shadow:
      inset 0 0 0 4px rgba(130, 210, 195, 0.32),
      inset 0 0 0 5px rgba(255, 255, 255, 0.14),
      inset 0 0 36px rgba(0, 25, 40, 0.55);
  }

  .open {
    position: absolute;
    z-index: 2;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    font-size: 0.85rem;
    background: rgba(3, 16, 30, 0.6);
    color: var(--ink);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .glass:hover .open,
  .open:focus-visible {
    opacity: 1;
  }

  .rim {
    height: 8px;
    margin: 0 -5px;
    border-radius: 2px 2px 3px 3px;
    background: linear-gradient(#22262c, #0b0d10);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* Wooden stand with a brass plaque. Fixed height: it's part of --chrome in Room.astro. */
  .cabinet {
    appearance: none;
    display: grid;
    place-items: center;
    width: 96%;
    height: 46px;
    margin: 0 auto;
    padding: 0;
    border: 0;
    border-radius: 0 0 4px 4px;
    font: inherit;
    color: inherit;
    cursor: pointer;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.4), transparent 9%, transparent 91%, rgba(0, 0, 0, 0.4)),
      repeating-linear-gradient(92deg, rgba(255, 220, 180, 0.025) 0 2px, transparent 2px 7px),
      linear-gradient(#3d2b1e, #21160e);
    box-shadow:
      inset 0 8px 10px -6px rgba(0, 0, 0, 0.8),
      0 24px 40px -18px rgba(0, 0, 0, 0.9);
  }

  .cabinet:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  :global([data-state='revealed']) .cabinet,
  .cabinet:disabled {
    cursor: default;
  }

  .plaque {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    width: 70%;
    min-width: min(100%, 12rem);
    height: 34px;
    padding: 0 14px;
    border-radius: 3px;
    text-align: center;
    color: #3a2709;
    text-shadow: 0 1px 0 rgba(255, 240, 200, 0.55);
    background: linear-gradient(160deg, #8c6424, #f1d27f 36%, #b78a36 52%, #e8c56c 72%, #8a6322);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3),
      0 2px 3px rgba(0, 0, 0, 0.6);
    transition: box-shadow 0.2s;
  }

  /* Screws */
  .plaque::before,
  .plaque::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-top: -2px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff3c4, #7a5518 70%);
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.4);
  }

  .plaque::before {
    left: 5px;
  }

  .plaque::after {
    right: 5px;
  }

  .name {
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font: 700 clamp(0.6rem, var(--tank-h) * 0.041, 0.86rem) / 1.15 var(--plaque-font);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: transform 0.2s;
  }

  /* Who made it and how, on one small line: hidden until the visitor votes. */
  .who {
    display: none;
    max-width: 100%;
    font: 500 0.58rem/1.2 'IBM Plex Mono', monospace;
    letter-spacing: 0.03em;
  }

  :global([data-state='revealed']) .who {
    display: flex;
    justify-content: center;
    gap: 0.5em;
    animation: reveal 0.6s both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }

  .artist {
    flex: none;
    font-weight: 600;
  }

  .medium {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0.75;
  }

  .medium:not(:empty)::before {
    content: '· ';
  }

  .hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3px;
    font: 500 0.5rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.2s;
  }

  :global([data-state='voting']) .tank:not(.empty):hover .plaque,
  :global([data-state='voting']) .cabinet:focus-visible .plaque {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3),
      0 0 16px rgba(255, 215, 120, 0.55);
  }

  :global([data-state='voting']) .tank:not(.empty):hover .name,
  :global([data-state='voting']) .cabinet:focus-visible .name {
    transform: translateY(-4px);
  }

  :global([data-state='voting']) .tank:hover .hint,
  :global([data-state='voting']) .cabinet:focus-visible .hint {
    opacity: 0.7;
  }

  /* When scrolling (phones), let plaques grow so long names can wrap. */
  @media (max-width: 699px), (max-height: 519px) {
    .cabinet {
      height: auto;
      padding: 6px 0;
    }

    .plaque {
      width: 92%;
      min-width: 0;
      height: auto;
      min-height: 34px;
      padding: 5px 12px;
    }

    .name {
      white-space: normal;
    }

    .hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge {
      transition: none;
    }

    :global([data-state='revealed']) .who {
      animation: none;
    }
  }
</style>
