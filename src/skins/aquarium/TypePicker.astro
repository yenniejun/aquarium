---
// Dev-only tool for choosing a type theme (see ./type-themes.css). Delete once one is picked.
const themes = [
  ['current', 'Current'],
  ['engraved', 'Engraved'],
  ['bubbly', 'Bubbly'],
  ['deco', 'Deco'],
  ['specimen', 'Specimen'],
  ['neon', 'Neon'],
  ['modern', 'Modern'],
];
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Fredoka:wght@500;600&family=IM+Fell+English:ital@0;1&family=Josefin+Sans:wght@600;700&family=Limelight&family=Monoton&family=Righteous&family=Space+Grotesk:wght@500;600&family=Special+Elite&family=Syne:wght@700;800&display=swap"
/>

<div class="picker" role="group" aria-label="Type theme">
  <span>Type</span>
  {
    themes.map(([id, label]) => (
      <button type="button" data-type-option={id}>
        {label}
      </button>
    ))
  }
</div>

<script>
  const KEY = 'museum:type';
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-type-option]')];
  const choose = (id: string) => {
    if (id === 'current') delete document.documentElement.dataset.type;
    else document.documentElement.dataset.type = id;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.typeOption === id)));
    try {
      localStorage.setItem(KEY, id);
    } catch {}
  };
  let saved: string | null = null;
  try {
    saved = localStorage.getItem(KEY);
  } catch {}
  choose(new URLSearchParams(location.search).get('type') ?? saved ?? 'current');
  buttons.forEach((b) => b.addEventListener('click', () => choose(b.dataset.typeOption!)));
</script>

<style>
  .picker {
    position: fixed;
    z-index: 10;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    padding: 8px 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 14px;
    background: rgba(3, 12, 24, 0.85);
    backdrop-filter: blur(8px);
    font: 500 0.68rem/1 'IBM Plex Mono', monospace;
    letter-spacing: 0.08em;
    color: #9ec3dc;
  }

  .picker span {
    margin: 0 0 4px;
    text-align: center;
    text-transform: uppercase;
  }

  button {
    appearance: none;
    padding: 6px 10px;
    border: 0;
    border-radius: 99px;
    text-align: left;
    background: transparent;
    color: #e6f5ff;
    font: inherit;
    cursor: pointer;
  }

  button:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  button[aria-pressed='true'] {
    background: #e6f5ff;
    color: #03101e;
  }
</style>
