# Honored by Cloudflare Pages and Netlify. If a visitor opens a piece directly, outside its
# sandboxed iframe, it is still sandboxed (opaque origin, can't touch site storage).
/pieces/*
  Content-Security-Policy: sandbox allow-scripts
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
